<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>Assets/start-app-ufo.ico</ApplicationIcon>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <!-- Release identity is explicit; default/debug builds never become update identities. -->
  <PropertyGroup Condition="'$(StartAppReleaseVersion)' != '' And '$(StartAppSourceCommit)' != ''">
    <InformationalVersion>$(StartAppReleaseVersion)+sha.$(StartAppSourceCommit)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup Condition="'$(StartAppSourceCommit)' != ''">
    <AssemblyMetadata Include="StartAppSourceCommit" Value="$(StartAppSourceCommit)" />
  </ItemGroup>
  <Target Name="ValidateStartAppIdentity" BeforeTargets="CoreCompile" Condition="'$(StartAppReleaseVersion)' != '' Or '$(StartAppSourceCommit)' != ''">
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(StartAppReleaseVersion)', '^(0|[1-9][0-9]{0,8})[.](0|[1-9][0-9]{0,8})[.](0|[1-9][0-9]{0,8})-proto[.](0|[1-9][0-9]{0,8})$'))" Text="Explicit prototype release version required" />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(StartAppSourceCommit)', '^[0-9a-f]{40}$'))" Text="Explicit source commit required" />
  </Target>
  <ItemGroup>
    <Resource Include="Assets/start-app-ufo.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\StartApp.Presentation\StartApp.Presentation.csproj" />
    <ProjectReference Include="..\StartApp.Platform.Windows\StartApp.Platform.Windows.csproj" />
    <ProjectReference Include="..\StartApp.Storage.Json\StartApp.Storage.Json.csproj" />
  </ItemGroup>
</Project>
