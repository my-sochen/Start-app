<Window x:Class="StartApp.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Start-app" Height="480" Width="860" MinWidth="720" MinHeight="360">
    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Margin="0,8,0,0" TextWrapping="Wrap"/>
        <DockPanel DockPanel.Dock="Left" Width="220" Margin="0,0,8,0">
            <Button DockPanel.Dock="Bottom" Content="Delete workspace" Command="{Binding DeleteWorkspaceCommand}" Margin="0,4,0,0"/>
            <Button DockPanel.Dock="Bottom" Content="Create workspace" Command="{Binding CreateWorkspaceCommand}" Margin="0,4,0,0"/>
            <TextBox DockPanel.Dock="Bottom" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0"/>
            <ListBox ItemsSource="{Binding Workspaces}" SelectedItem="{Binding Selected}" DisplayMemberPath="Name"/>
        </DockPanel>
        <DockPanel>
            <DockPanel DockPanel.Dock="Top">
                <Button DockPanel.Dock="Left" Content="Open workspace" Command="{Binding OpenWorkspaceCommand}" Padding="8,2"/>
                <Button DockPanel.Dock="Right" Content="Add" Command="{Binding AddItemCommand}" Margin="4,0,0,0" Padding="12,2"/>
                <ComboBox DockPanel.Dock="Left" ItemsSource="{Binding ItemTypes}" SelectedItem="{Binding NewItemType}" Width="90" Margin="16,0,0,0"/>
                <TextBox Text="{Binding NewTarget, UpdateSourceTrigger=PropertyChanged}" MinWidth="120" Margin="4,0,0,0"/>
            </DockPanel>
            <Grid DockPanel.Dock="Top" Margin="8,8,8,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Name" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="Type" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="2" Text="Target" FontWeight="SemiBold"/>
            </Grid>
            <ListView ItemsSource="{Binding Items}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Type}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding Target}" ToolTip="{Binding Target}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <Button Grid.Column="3" Content="Remove"
                                    Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </DockPanel>
    </DockPanel>
</Window>
