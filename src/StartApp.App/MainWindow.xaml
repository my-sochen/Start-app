<Window x:Class="StartApp.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StartApp.App"
        Title="Start-app" WindowStyle="None" Icon="Assets/start-app-ufo.ico" FontFamily="./Assets/Fonts/#Noto Sans Hebrew, Arial" FontSize="15" Background="#F7F8FB" Height="560" Width="900" MinWidth="720" MinHeight="400">
    <!-- Tabs and explicit caption controls share the title row. WindowChrome keeps dragging/resizing;
         explicit SystemCommands-backed controls remain visible when desktop composition is unavailable. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <local:ColorBrushConverter x:Key="ColorBrush"/>
        <local:CardBrushConverter x:Key="CardBrush"/>
        <local:FrameThicknessConverter x:Key="FrameThickness"/>
        <local:NullToVisibilityConverter x:Key="NullToVisibility"/>
        <local:CardSizeFontConverter x:Key="CardSizeFont"/>
        <local:CardSizePaddingConverter x:Key="CardSizePadding"/>
        <ContextMenu x:Key="WorkspaceActionsMenu" x:Shared="false">
            <MenuItem Header="הצג" Command="{Binding PlacementTarget.Tag.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
            <MenuItem Header="שגר" Command="{Binding PlacementTarget.Tag.OpenWorkspaceForCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
            <MenuItem Header="הוסף אייטם" Command="{Binding PlacementTarget.Tag.AddItemToCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
            <Separator/><MenuItem Header="עצב כרטיס" Command="{Binding PlacementTarget.Tag.DesignCardCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
            <MenuItem Header="ערוך קטגוריה" Command="{Binding PlacementTarget.Tag.EditCategoryPopupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
            <!-- path 2 (approved 22.11): separator + final row; sets/clears סביבת ברירת המחדל immediately, no confirm dialog. -->
            <Separator/>
            <MenuItem Command="{Binding PlacementTarget.Tag.ToggleDefaultForCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"
                      AutomationProperties.Name="Toggle default workspace">
                <MenuItem.Header>
                    <MultiBinding Converter="{StaticResource DefaultMenuHeader}">
                        <Binding Path="."/>
                        <Binding Path="PlacementTarget.Tag" RelativeSource="{RelativeSource AncestorType=ContextMenu}"/>
                    </MultiBinding>
                </MenuItem.Header>
            </MenuItem>
        </ContextMenu>
        <!-- תצוגה templates (approved 22.11): כרטיסים ברירת מחדל, רשימה, אייקונים (שם וצבע בלבד) -->
        <DataTemplate x:Key="WorkspaceCardTemplate">
                            <!-- White card, 5px workspace-color top bar and neutral hairline outline.
                                 A chosen image remains the card surface, without the obsolete wrapping color frame. -->
                            <Border ContextMenuOpening="RowContextMenu_Opening" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="Workspace actions" FlowDirection="LeftToRight" Margin="8,0,8,16" CornerRadius="4" BorderBrush="#D6DCE5" BorderThickness="1" MinHeight="173">
                                <Border.Background>
                                    <MultiBinding Converter="{StaticResource CardSurface}">
                                        <Binding Path="Color"/>
                                        <Binding Path="ImagePath"/>
                                    </MultiBinding>
                                </Border.Background>

                            <Border.ContextMenu><StaticResource ResourceKey="WorkspaceActionsMenu"/></Border.ContextMenu>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="5"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Height="5" CornerRadius="3,3,0,0"
                                        Background="{Binding Color, Converter={StaticResource TopBarBrush}}"/>
                                <Button Grid.Row="1" Command="{Binding DataContext.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" AutomationProperties.AutomationId="WorkspaceTitle"
                                        Background="Transparent" BorderThickness="0"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" Padding="16,15,16,0" AutomationProperties.Name="{Binding Name}">
                                    <!-- סביבת ברירת מחדל badge (approved 22.11 handoff): 11px green dot #3F9D63 directly left of the
                                         name (RTL: second child in the horizontal stack), only on the one default workspace's card. -->
                                    <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#222833" TextAlignment="Right"
                                                   FontSize="{Binding DataContext.CurrentCardSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource CardSizeFont}}"/>
                                        <Ellipse Width="11" Height="11" Fill="#3F9D63" Margin="0,0,6,0" VerticalAlignment="Center"
                                                 AutomationProperties.Name="Default workspace badge"
                                                 ToolTip="סביבת ברירת מחדל · נפתחת אוטומטית עם הפעלת המחשב">
                                            <Ellipse.Visibility>
                                                <MultiBinding Converter="{StaticResource DefaultBadgeVisibility}">
                                                    <Binding Path="."/>
                                                    <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                </MultiBinding>
                                            </Ellipse.Visibility>
                                        </Ellipse>
                                    </StackPanel>
                                </Button>
                                <Border Grid.Row="2" Background="#F4F6F9" BorderBrush="#DBE0E8" BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="16,7,16,0" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding EffectiveCategory}" Foreground="#4B5563" FontSize="11"/>
                                </Border>
                                <TextBlock Grid.Row="3" TextAlignment="Right" Foreground="#586473" FontSize="13" Margin="16,12,16,11">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource StatsText}">
                                            <Binding Path="."/>
                                            <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <Border Grid.Row="4" BorderBrush="#EDF0F5" BorderThickness="0,1,0,0" Padding="16,10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="שגר" Style="{StaticResource PrimaryActionButton}" Padding="20,5" MinHeight="32" VerticalAlignment="Center"
                                            IsEnabled="{Binding Converter={StaticResource HasItemsToBool}}"
                                            Command="{Binding DataContext.OpenWorkspaceForCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Stretch">
                                        <TextBlock Foreground="#626B79" FontSize="12" TextAlignment="Right" TextWrapping="Wrap">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource FooterLine1}">
                                                    <Binding Path="."/>
                                                    <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <Button Content="הצגת פרטים ←" Style="{StaticResource QuietTextButton}" HorizontalAlignment="Right" Margin="0,2,0,0"
                                                Command="{Binding DataContext.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                AutomationProperties.Name="Show details"/>
                                    </StackPanel>
                                </Grid>
                                </Border>
                            </Grid>
                            </Border>
                        </DataTemplate>
        <DataTemplate x:Key="WorkspaceListTemplate">
            <!-- approved 22.11 list mock (pixel-exact): white row, 1px #D6DCE5 border, radius 5, 5px color stripe at
                 the RIGHT edge (RTL start; the mock's explicit correction over the feat-33 left stripe), padding
                 12,9,14,9, 10px row gap; the whole row (minus שגר) opens details, no visible details link. -->
            <Border ContextMenuOpening="RowContextMenu_Opening" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="Workspace actions"
                    Margin="0,0,0,10" Background="White" BorderBrush="#D6DCE5" BorderThickness="1" CornerRadius="5">
                <Border.ContextMenu><StaticResource ResourceKey="WorkspaceActionsMenu"/></Border.ContextMenu>
                <Grid>
                    <DockPanel Margin="12,9,14,9" LastChildFill="True">
                        <Button DockPanel.Dock="Left" Content="שגר" Style="{StaticResource PrimaryActionButton}" MinHeight="32" Padding="20,5" VerticalAlignment="Center"
                                IsEnabled="{Binding Converter={StaticResource HasItemsToBool}}"
                                Command="{Binding DataContext.OpenWorkspaceForCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#626B79" FontSize="12" Margin="14,0,0,0">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource FooterLine1List}">
                                    <Binding Path="."/>
                                    <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <Button Command="{Binding DataContext.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" AutomationProperties.AutomationId="WorkspaceTitle"
                                Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Right" Padding="0" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="RightToLeft">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" Foreground="#222833" MinWidth="150" TextAlignment="Right"/>
                                <Ellipse Width="11" Height="11" Fill="#3F9D63" Margin="0,0,8,0" VerticalAlignment="Center"
                                         AutomationProperties.Name="Default workspace badge"
                                         ToolTip="סביבת ברירת מחדל · נפתחת אוטומטית עם הפעלת המחשב">
                                    <Ellipse.Visibility>
                                        <MultiBinding Converter="{StaticResource DefaultBadgeVisibility}">
                                            <Binding Path="."/>
                                            <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        </MultiBinding>
                                    </Ellipse.Visibility>
                                </Ellipse>
                                <Border Background="#F3F4F6" CornerRadius="9" Padding="8,2" Margin="4,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding EffectiveCategory}" Foreground="#4B5563" FontSize="11"/>
                                </Border>
                                <TextBlock VerticalAlignment="Center" Foreground="#586473" FontSize="13" MinWidth="210" TextAlignment="Right">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource StatsText}">
                                            <Binding Path="."/>
                                            <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </DockPanel>
                    <Border HorizontalAlignment="Right" Width="5" CornerRadius="0,4,4,0" IsHitTestVisible="False"
                            Background="{Binding Color, Converter={StaticResource TopBarBrush}}"/>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="WorkspaceIconsTemplate">
            <Border ContextMenuOpening="RowContextMenu_Opening" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="Workspace actions" Margin="2" Padding="6,3" CornerRadius="3"
                    BorderBrush="{Binding Color, Converter={StaticResource ColorBrush}}" BorderThickness="1" Background="{Binding Color, Converter={StaticResource ColorBrush}}">
                <Border.ContextMenu><StaticResource ResourceKey="WorkspaceActionsMenu"/></Border.ContextMenu>
                <Button Command="{Binding DataContext.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" AutomationProperties.AutomationId="WorkspaceTitle"
                        Background="Transparent" BorderThickness="0" Padding="2" AutomationProperties.Name="{Binding Name}">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                </Button>
            </Border>
        </DataTemplate>
        
        <local:ItemEditorVisibilityConverter x:Key="ItemEditorVisibility"/>
        <!-- view-template panels (approved 22.11 mock set): cards = 3-column grid, list = vertical rows, icons = wrapping tiles -->
        <ItemsPanelTemplate x:Key="CardGridPanel"><UniformGrid Columns="3" FlowDirection="RightToLeft" VerticalAlignment="Top"/></ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="ListRowsPanel"><StackPanel Orientation="Vertical"/></ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="IconTilesPanel"><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
        <local:DetailsGroupConverter x:Key="DetailsGroup"/>
        <CollectionViewSource x:Key="ItemsView" Source="{Binding Items}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </Window.Resources>
    <Border BorderBrush="#BDC3CF" BorderThickness="1">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- App identity and tabs at left; caption controls at right. -->
        <Border Grid.Row="0" Background="#E9ECF2" BorderBrush="#E2E6EC" BorderThickness="0,0,0,1">
            <Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,14,0" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Content="−" FontFamily="Arial" FontSize="16" Foreground="#646E7D" Width="52" Style="{StaticResource TitleBarTab}" Click="MinimizeWindow_Click" AutomationProperties.Name="Minimize window"/>
                <Button x:Name="MaximizeWindowButton" Content="□" FontFamily="Arial" FontSize="16" Foreground="#646E7D" Width="52" Style="{StaticResource TitleBarTab}" Click="ToggleMaximizeWindow_Click" AutomationProperties.Name="Maximize window"/>
                <Button Content="×" FontFamily="Arial" FontSize="16" Foreground="#646E7D" Width="52" Style="{StaticResource TitleBarTab}" Click="CloseWindow_Click" AutomationProperties.Name="Close window"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Left" Margin="0,0,170,0">
                <Image Source="Assets/start-app-ufo.png" Width="25" Height="25" Margin="14,0,9,0" VerticalAlignment="Center"/>
                <TextBlock Text="Start-app" FontWeight="Normal" FontSize="13" VerticalAlignment="Center"/>
                <Border Width="1" Height="18" Background="#C6CCD8" Margin="20,0,12,0" VerticalAlignment="Center"/>
                <Button Content="אופציות" Click="OptionsMenu_Click" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" Padding="12,0"
                        Style="{StaticResource TitleBarTab}" WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="Options menu"/>
                <Button Content="תצוגה" Click="ViewMenu_Click" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" Padding="12,0"
                        Style="{StaticResource TitleBarTab}" WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="View menu"/>
                <Button Content="הגדרות" Command="{Binding OpenSettingsCommand}" Padding="12,0"
                        Style="{StaticResource TitleBarTab}" WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="Settings"/>
                <Button Content="עזרה" Click="HelpMenu_Click" Padding="12,0"
                        Style="{StaticResource TitleBarTab}" WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="Help menu">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="אודות Start-app" Click="AboutMenuItem_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="3" Height="37" Padding="18,8" Background="#EEF1F6" BorderBrush="#DCE0E7" BorderThickness="0,1,0,0"
                Visibility="{Binding InCreate, Converter={StaticResource NotB2V}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="לחיצה ימנית לפעולות נוספות · Shift+F10 מקלדת" FontSize="11" Foreground="#566173" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Left" Content="פתח הורדה רשמית" Command="{Binding Updates.DownloadCommand, RelativeSource={RelativeSource AncestorType=Window}}" Padding="8,2"
                        Visibility="{Binding Updates.UpdateAvailable, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource B2V}}" AutomationProperties.Name="Open official download"/>
                <TextBlock Text="הצעת עיצוב לבטא" FontSize="11" Foreground="#566173" VerticalAlignment="Center"
                           ToolTip="{Binding Updates.Status, RelativeSource={RelativeSource AncestorType=Window}}"/>
            </DockPanel>
        </Border>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============ OVERVIEW: workspace cards + create form ============ -->
            <DockPanel Margin="28,39,28,16" Visibility="{Binding InOverview, Converter={StaticResource B2V}}">
                <!-- approved 22.11 home toolbar: capture + new-workspace buttons at the left, workspace search at the right -->
                <Grid DockPanel.Dock="Top" Margin="4,0,4,16" Height="42">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Width="44" Height="42" Style="{StaticResource HomeToolbarButton}" Margin="0,0,10,0" AutomationProperties.Name="Capture"
                                Click="CaptureMenu_Click" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                            <Image Source="Assets/start-app-ufo.png" Width="20" Height="20" RenderTransformOrigin="0.5,0.5"><Image.RenderTransform><RotateTransform Angle="180"/></Image.RenderTransform></Image>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="סביבה חדשה" Command="{Binding PlacementTarget.Tag.CaptureNewCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="סביבה קיימת" Command="{Binding PlacementTarget.Tag.CaptureExistingCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Content="+" Width="40" Height="42" Style="{StaticResource HomeToolbarButton}" FontWeight="SemiBold" AutomationProperties.Name="New workspace button"
                                ToolTip="סביבה חדשה" Click="NewWorkspaceFocus_Click"/>
                    </StackPanel>
                    <Border HorizontalAlignment="Right" Width="340" Background="White" BorderBrush="#C5CDDB" BorderThickness="1" CornerRadius="4" Padding="14,10">
                        <Grid>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#626B79" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBlock Text="חיפוש סביבות עבודה" Foreground="#626B79" FontSize="13" IsHitTestVisible="False" Margin="0,0,20,0"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Visibility="{Binding Text, ElementName=WorkspaceSearchBox, Converter={StaticResource StringEmptyToVisibility}}"/>
                            <TextBox x:Name="WorkspaceSearchBox" Text="{Binding FilterContainsText, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" Background="Transparent" FontSize="13" FlowDirection="RightToLeft" Margin="0,0,20,0"
                                     AutomationProperties.Name="Workspace search"/>
                        </Grid>
                    </Border>
                </Grid>
                <Border DockPanel.Dock="Top" Background="#EFF8F3" BorderBrush="#CADFD5" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,0,6"
                        Visibility="{Binding HasActiveFilters, Converter={StaticResource B2V}}" AutomationProperties.Name="Filter bar">
                    <Grid>
                    <DockPanel Visibility="{Binding IsSingleContentFilter, Converter={StaticResource NotB2V}}">
                        <TextBlock DockPanel.Dock="Right" Text="מסונן:" VerticalAlignment="Center" Foreground="#2B6250" Margin="4,0,6,0"/>
                        <Button DockPanel.Dock="Left" Content="✕ ניקוי הכל" Background="Transparent" BorderThickness="0" Foreground="#2B6250" Padding="4,0"
                                Command="{Binding ClearFiltersCommand}" AutomationProperties.Name="Clear all filters"/>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding FilteredCountText}" VerticalAlignment="Center" Foreground="#2B6250" Margin="8,0,0,0" AutomationProperties.Name="Filter count"/>
                        <ItemsControl ItemsSource="{Binding FilterChips}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Border Background="White" BorderBrush="#B9D4C6" BorderThickness="1" CornerRadius="12" Padding="8,1" Margin="0,0,4,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="13" Height="13" Margin="0,0,4,0" VerticalAlignment="Center"
                                                 Fill="{Binding ColorHex, Converter={StaticResource ColorBrush}}"
                                                 Visibility="{Binding ColorHex, Converter={StaticResource NullToVisibility}}"/>
                                        <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center"/>
                                        <Button Content="✕" FontSize="10" Background="Transparent" BorderThickness="0" Padding="4,0" VerticalAlignment="Center"
                                                Command="{Binding DataContext.RemoveFilterChipCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Key}"
                                                AutomationProperties.Name="Remove filter"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                    <!-- single content filter (approved mock home-filter-program): "מסונן: סביבות שמכילות X · N מתוך M" + ✕ ניקוי סינון -->
                    <DockPanel Visibility="{Binding IsSingleContentFilter, Converter={StaticResource B2V}}">
                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#2B6250" Margin="4,0,6,0">
                            <Run Text="מסונן: סביבות שמכילות "/><Run Text="{Binding SingleContentFilterName, Mode=OneWay}" FontWeight="Bold"/><Run Text=" · "/><Run Text="{Binding SingleFilterCountText, Mode=OneWay}"/>
                        </TextBlock>
                        <Button DockPanel.Dock="Left" Content="✕ ניקוי סינון" Background="Transparent" BorderThickness="0" Foreground="#2B6250" Padding="4,0"
                                Command="{Binding ClearFiltersCommand}" AutomationProperties.Name="Clear all filters"/>
                    </DockPanel>
                    </Grid>
                </Border>
                <TextBlock DockPanel.Dock="Bottom" FlowDirection="RightToLeft" Text="{Binding Workspaces.Count, StringFormat={}{0} סביבות עבודה · תוצאות הפתיחה האחרונות זמינות בתפריט אופציות}" FontSize="12" Foreground="#626B79" HorizontalAlignment="Right" Margin="0,12,0,0"/>
                <ListBox x:Name="WorkspaceList" ItemsSource="{Binding DisplayWorkspaces}" ItemTemplate="{StaticResource WorkspaceCardTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" AutomationProperties.Name="Workspace list">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/></ControlTemplate></Setter.Value></Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <!-- approved 22.11 mock: the card view is a 3-column grid (ViewMenu swaps this panel per template) -->
                    <ListBox.ItemsPanel>
                        <StaticResource ResourceKey="CardGridPanel"/>
                    </ListBox.ItemsPanel>
                </ListBox>
            </DockPanel>

            <local:CreateWorkspaceView x:Name="CreateView" Visibility="{Binding InCreate, Converter={StaticResource B2V}}"/>

            <!-- ============ DETAILS: פרטי סביבה ============ -->
            <DockPanel Margin="32,22,32,22" Visibility="{Binding InDetails, Converter={StaticResource B2V}}">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock FlowDirection="RightToLeft" FontSize="12" Foreground="#636E7D" Margin="0,0,0,17"><Run Text="סביבות העבודה"/><Run Text="   /   "/><Run Text="{Binding Selected.Name}" Foreground="#222833"/></TextBlock>
                    <Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Button Content="שגר" Command="{Binding OpenWorkspaceCommand}" Style="{StaticResource HomeToolbarButton}" MinWidth="57" Height="38"/>
                            <Button Content="שמור פרטים" AutomationProperties.Name="Save workspace details" Command="{Binding SaveDetailsCommand}" Style="{StaticResource PrimaryActionButton}" Padding="16,8" MinWidth="112" Height="38" Margin="8,0,0,0" Visibility="{Binding DetailsDirty, Converter={StaticResource B2V}}"/>
                            <Button Content="חזרה לסביבות" Command="{Binding BackCommand}" Style="{StaticResource HomeToolbarButton}" MinWidth="123" Height="38" Margin="8,0,0,0" AutomationProperties.Name="Back to workspaces"/>
                            <Button Content="{Binding DefaultToggleLabel}" Style="{StaticResource QuietTextButton}" Command="{Binding ToggleDefaultForCommand}" CommandParameter="{Binding Selected}" Margin="18,0,0,0" AutomationProperties.Name="Toggle default workspace"/>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" FlowDirection="RightToLeft">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Selected.Name}" FontWeight="SemiBold" FontSize="22"/>
                                <Ellipse Width="11" Height="11" Fill="#3F9D63" Margin="7,0,0,0" VerticalAlignment="Center" Visibility="{Binding SelectedIsDefault, Converter={StaticResource B2V}}" AutomationProperties.Name="Default workspace badge"/>
                            </StackPanel>
                            <TextBlock Text="יש שינויים בפרטי הסביבה שעדיין לא נשמרו" Foreground="#626B79" FontSize="13" Margin="0,5,0,0" Visibility="{Binding DetailsDirty, Converter={StaticResource B2V}}"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="0.65*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
                        <StackPanel FlowDirection="RightToLeft"><TextBlock Text="תיאור" Style="{StaticResource DetailsLabel}"/><TextBox Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DetailsInput}" MaxLength="500" AutomationProperties.Name="Workspace description"/></StackPanel>
                        <StackPanel Grid.Column="2" FlowDirection="RightToLeft"><TextBlock Text="קטגוריה" Style="{StaticResource DetailsLabel}"/><ComboBox ItemsSource="{Binding CategoryChoices}" SelectedItem="{Binding EditCategory}" Style="{StaticResource DetailsCombo}" AutomationProperties.Name="Workspace category"/></StackPanel>
                        <StackPanel Grid.Column="4" FlowDirection="RightToLeft"><TextBlock Text="שם הסביבה" Style="{StaticResource DetailsLabel}"/><TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DetailsInput}" AutomationProperties.Name="Workspace name"/></StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding DetailsError}" Foreground="#9B3030" TextWrapping="Wrap" FlowDirection="RightToLeft">
                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <Border BorderBrush="#DBE0E8" BorderThickness="0,0,0,1" Padding="0,8,0,12" Margin="0,18,0,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Content="+ הוסף אייטם" Click="ShowDetailsAddForm_Click" Style="{StaticResource HomeToolbarButton}" MinWidth="126" Height="38"/>
                                <Button Content="הוסף ממה שפתוח" Command="{Binding AddFromOpenCommand}" Style="{StaticResource HomeToolbarButton}" MinWidth="147" Height="38" Margin="8,0,0,0" AutomationProperties.Name="Add from open items"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Items.Count, StringFormat='אייטמים בסביבה {0}'}" FlowDirection="RightToLeft" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" AutomationProperties.Name="Workspace details viewport" FlowDirection="RightToLeft">
                <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,8,0,0" Visibility="{Binding ShowEmptyItemsMessage, Converter={StaticResource B2V}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="עדיין אין אייטמים בסביבה" VerticalAlignment="Center" FontStyle="Italic"/>
                        <Button Content="הוסף אייטם" Command="{Binding FocusAddCommand}" Padding="10,2" Margin="8,0,0,0"/>
                    </DockPanel>
                </StackPanel>
                <StackPanel x:Name="DetailsAddForm" Visibility="Collapsed" DockPanel.Dock="Top" Margin="0,8,0,0">
                    <DockPanel>
                        <ComboBox DockPanel.Dock="Left" ItemsSource="{Binding ItemTypes}" SelectedItem="{Binding NewItemType}" Width="90" AutomationProperties.Name="Item type"/>
                        <Button DockPanel.Dock="Right" Content="Add" Command="{Binding AddItemCommand}" Margin="4,0,0,0" Padding="12,2"/>
                        <TextBox x:Name="TargetBox" Text="{Binding NewTarget, UpdateSourceTrigger=PropertyChanged}" MinWidth="120" Margin="4,0,0,0" AutomationProperties.Name="Item target"/>
                    </DockPanel>
                    <TextBlock Text="{Binding AddItemError}" Foreground="#9B3030" TextWrapping="Wrap" FlowDirection="RightToLeft"/>
                    <DockPanel Margin="0,4,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="Name (optional)" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding NewItemName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Item name"/>
                    </DockPanel>
                    <DockPanel Margin="0,4,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="Description (optional)" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" AutomationProperties.Name="Item description"/>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding DuplicatePending, Converter={StaticResource B2V}}">
                        <TextBlock Text="{Binding DuplicateMessage}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="480"/>
                        <Button Content="Add anyway" Command="{Binding ConfirmDuplicateCommand}" Padding="8,2" Margin="8,0,0,0"/>
                        <Button Content="Cancel" Command="{Binding CancelDuplicateCommand}" Padding="8,2" Margin="4,0,0,0"/>
                    </StackPanel>
                    <Button Content="בחר מסביבות קיימות" Command="{Binding OpenPickerCommand}" HorizontalAlignment="Left" Margin="0,4,0,0" Padding="10,2" AutomationProperties.Name="Pick from existing resources"/>
                    <Button Content="הוסף ממה שפתוח" Command="{Binding AddFromOpenCommand}" HorizontalAlignment="Left" Margin="0,4,0,0" Padding="10,2" AutomationProperties.Name="Add from open items"/>
                </StackPanel>
                <ListView ItemsSource="{Binding Source={StaticResource ItemsView}}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="0" FlowDirection="RightToLeft">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem"><Border BorderBrush="#EEF0F4" BorderThickness="0,0,0,1"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle><Style TargetType="GroupItem"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupItem"><Border BorderBrush="#DCE1E9" BorderThickness="1" Background="White" CornerRadius="4" Margin="0,8,0,0"><DockPanel><ContentPresenter DockPanel.Dock="Top" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/><ItemsPresenter/></DockPanel></Border></ControlTemplate></Setter.Value></Setter></Style></GroupStyle.ContainerStyle>
                            <GroupStyle.HeaderTemplate><DataTemplate>
                                <Border Background="#F0F3F8" BorderBrush="#DFE4EC" BorderThickness="0,0,0,1" Padding="14,6">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" FontSize="12" Foreground="#414856"><Run Text="{Binding Name, Converter={StaticResource DetailsGroup}}"/><Run Text=" · "/><Run Text="{Binding ItemCount, Mode=OneWay}"/></TextBlock>
                                        <TextBlock Text="{Binding Name, Converter={StaticResource DetailsGroup}, ConverterParameter=hint}" HorizontalAlignment="Right" FontSize="11" Foreground="#626B79"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate></GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ContextMenuOpening="RowContextMenu_Opening" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="Item row" FlowDirection="RightToLeft" MinHeight="48" Margin="14,0">
                                <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="מחיקה" Command="{Binding PlacementTarget.Tag.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                <MenuItem Header="העתק כתובת" Command="{Binding PlacementTarget.Tag.CopyAddressCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                <MenuItem Header="עריכת כתובת" Command="{Binding PlacementTarget.Tag.EditAddressCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                <MenuItem Header="פתח באמצעות" Command="{Binding PlacementTarget.Tag.OpenWithCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}">
                                                    <MenuItem.Style><Style TargetType="MenuItem"><Style.Triggers>
                                                        <!-- a program item IS the program; open-with does not apply to it -->
                                                        <DataTrigger Binding="{Binding IsProgram}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                    </Style.Triggers></Style></MenuItem.Style>
                                                </MenuItem>
                                                <Separator/><MenuItem Header="הזז למעלה" Command="{Binding PlacementTarget.Tag.MoveItemUpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                <MenuItem Header="הזז למטה" Command="{Binding PlacementTarget.Tag.MoveItemDownCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                <!-- settled display condition: shown only when another workspace exists; the share popup itself is still undefined (הפרטים טרם הוגדרו), so the entry stays disabled -->
                                                <MenuItem Header="שיתוף לסביבה אחרת" IsEnabled="False" Visibility="Collapsed"/>
                                                <!-- הוסף סקריפט למפתחים: shown only "אם רלוונטי" and that relevance is still undefined (הפרטים טרם הוגדרו), so it is deliberately not in the menu -->
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="0"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="0"/><ColumnDefinition Width="*"/><ColumnDefinition Width="62"/></Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Command="{Binding DataContext.OpenItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource QuietTextButton}" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" VerticalAlignment="Center" Cursor="Hand" ToolTip="פתיחת האייטם" Padding="0" AutomationProperties.Name="{Binding Name}">
                                    <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                        <Border Width="30" Height="30" VerticalAlignment="Center" Background="#EEF2F9" BorderBrush="#D9E0EF" BorderThickness="1" CornerRadius="6" Margin="0,0,12,0"><local:TargetIcon Target="{Binding Target}" ItemType="{Binding Type}"/></Border>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="260" FontSize="13" FontWeight="SemiBold" TextDecorations="Underline" Foreground="#315CC5"/>
                                            <TextBlock Text="{Binding Description}" Foreground="#677282" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="260">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger><Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                            <local:ProgramIconView Program="{Binding Program}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                                <TextBlock Grid.Column="2" Text="{Binding Target}" ToolTip="{Binding Target}" TextTrimming="CharacterEllipsis" FontFamily="Arial" FontSize="12" Foreground="#606D80" Margin="12,0" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                                <Button Grid.Column="3" Content="ערוך" Click="EditItem_Click" AutomationProperties.Name="Edit item" Style="{StaticResource HomeToolbarButton}" Height="38" VerticalAlignment="Center" ToolTip="עריכת האייטם, ללא פתיחה" Command="{Binding DataContext.EditItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                <Border Grid.Row="2" Grid.ColumnSpan="4" Margin="0,8,0,0" BorderBrush="Gray" BorderThickness="1" Padding="6"
                        >
                    <Border.Visibility><MultiBinding Converter="{StaticResource ItemEditorVisibility}"><Binding Path="InstanceId"/><Binding Path="DataContext.EditingItemInstanceId" RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></Border.Visibility>
                    <StackPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" FlowDirection="RightToLeft">
                        <TextBlock Text="עריכת אייטם" FontWeight="SemiBold"/>
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="שם" Width="80" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding EditItemName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Edit item name"/>
                        </DockPanel>
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="תיאור" Width="80" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding EditItemDescription, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" AutomationProperties.Name="Edit item description"/>
                        </DockPanel>
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="כתובת" Width="80" VerticalAlignment="Center"/>
                            <TextBox FlowDirection="LeftToRight" Text="{Binding EditItemTarget, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Edit item target"/>
                        </DockPanel>
                    <TextBlock Text="{Binding ItemEditError}" Foreground="#9B3030" TextWrapping="Wrap" FlowDirection="RightToLeft"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="שמור" AutomationProperties.Name="Save item edit" Command="{Binding SaveItemEditCommand}" Padding="12,2" Margin="0,0,6,0"
                                    Visibility="{Binding ItemEditDirty, Converter={StaticResource B2V}}"/>
                            <Button Content="ביטול" AutomationProperties.Name="Cancel item edit" Command="{Binding CancelItemEditCommand}" Padding="12,2"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                </DockPanel>
                </ScrollViewer>
            </DockPanel>

            <!-- Progress is nonmodal; completed results are opened only by explicit user choice. -->
            <StackPanel Grid.Row="1" Margin="8,0,8,8">
                <StackPanel Visibility="{Binding ShowOpenPanel, Converter={StaticResource B2V}}" Orientation="Horizontal">
                    <TextBlock Text="בודק או שולח בקשות פתיחה..." VerticalAlignment="Center"/>
                    <Button Content="ביטול" Command="{Binding CancelOpenCommand}" Padding="10,2" Margin="8,0"/>
                </StackPanel>
                <Button Content="תוצאות הפתיחה האחרונות" Command="{Binding ShowLastOpeningResultsCommand}" HorizontalAlignment="Right" Padding="10,3" Visibility="{Binding HasLastOpeningResults, Converter={StaticResource B2V}}" AutomationProperties.Name="Last opening results"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Panel.ZIndex="100" Background="#FFF2D5" BorderBrush="#B48629" BorderThickness="1" Padding="10" Visibility="{Binding SaveBlocked, Converter={StaticResource B2V}}" FlowDirection="RightToLeft">
            <TextBlock Text="{Binding SaveBlockedMessage}" TextWrapping="Wrap"/>
        </Border>

        <!-- ============ capture screen (מסך לכידה): open-now list on one side; new-workspace form, workspace search or the chosen workspace on the other ============ -->
        <Grid Grid.Row="2" Visibility="{Binding CaptureOpen, Converter={StaticResource B2V}}" Background="White">
            <DockPanel Margin="8">
                <DockPanel DockPanel.Dock="Top">
                    <Button DockPanel.Dock="Right" Content="✕" Command="{Binding CaptureCloseCommand}" Padding="8,2" AutomationProperties.Name="Close capture" ToolTip="Close capture"/>
                    <TextBlock Text="לכידה" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
                </DockPanel>
                <Expander DockPanel.Dock="Top" Header="מה ניתן ללכוד?" FlowDirection="RightToLeft" Margin="0,3,0,6"><TextBlock Text="הלכידה קוראת חלונות ולשוניות נגישים בלבד ואינה רשימה מלאה של כל מה שפתוח. בדיקת לשוניות עשויה להחליף ביניהן לרגע. מסמכים פתוחים בתוך תוכנות אינם מזוהים באופן כללי. דפדפנים וגרסאות שונים, חלונות מוגנים ולשוניות לא פעילות עשויים לא להיקרא. אותו אתר בכמה דפדפנים מופיע בנפרד לכל דפדפן. הדפדפן נשמר כשזוהה; הפרופיל אינו נשמר. אפשר להוסיף פריטים ידנית." TextWrapping="Wrap"/></Expander>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                    <!-- left: depends on the stage -->
                    <Grid Grid.Column="0">
                        <StackPanel Visibility="{Binding IsCaptureNew, Converter={StaticResource B2V}}">
                            <TextBlock Text="סביבה חדשה" FontWeight="SemiBold"/>
                            <DockPanel Margin="0,4,0,0"><TextBlock DockPanel.Dock="Left" Text="Name" Width="80" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Capture workspace name"/></DockPanel>
                            <DockPanel Margin="0,4,0,0"><TextBlock DockPanel.Dock="Left" Text="Description" Width="80" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding NewWorkspaceDescription, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" AutomationProperties.Name="Capture workspace description"/></DockPanel>
                            <DockPanel Margin="0,4,0,0"><TextBlock DockPanel.Dock="Left" Text="Category" Width="80" VerticalAlignment="Center"/>
                                <ComboBox ItemsSource="{Binding CategoryChoices}" SelectedItem="{Binding NewWorkspaceCategory}" MinWidth="120" HorizontalAlignment="Left" AutomationProperties.Name="Capture workspace category"/></DockPanel>
                            <!-- optional card design at creation, same fields as the ordinary create form -->
                            <DockPanel Margin="0,4,0,0"><TextBlock DockPanel.Dock="Left" Text="Color" Width="80" VerticalAlignment="Center"/>
                                <TextBox DockPanel.Dock="Left" Text="{Binding NewWorkspaceColor, UpdateSourceTrigger=PropertyChanged}" Width="90" ToolTip="#RRGGBB" AutomationProperties.Name="Capture card color"/>
                                <ItemsControl ItemsSource="{Binding DesignPalette}" Margin="8,0,0,0" AutomationProperties.Name="Capture palette">
                                    <!-- finite remaining width (DockPanel, not a horizontal StackPanel which measures children with
                                         infinite width) + WrapPanel: at the window minimum the narrow capture column clipped the last
                                         swatch; wrapping inside the bounded space keeps all seven on screen, same order/semantics.
                                         The unique automation name anchors e2e lookups: the overview stays Visible behind this
                                         overlay, so the two palettes' hex-named swatches are ambiguous in the window-wide UIA tree -->
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Button Width="22" Height="22" Margin="0,0,4,0" BorderBrush="Gray" BorderThickness="1"
                                                Background="{Binding ., Converter={StaticResource ColorBrush}}"
                                                Command="{Binding DataContext.ApplyCreatePaletteColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                ToolTip="{Binding}" AutomationProperties.Name="{Binding}"/>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                            <DockPanel Margin="0,4,0,0"><TextBlock DockPanel.Dock="Left" Text="Image" Width="80" VerticalAlignment="Center"/>
                                <Button DockPanel.Dock="Right" Content="הסר תמונה" Command="{Binding RemoveCreateImageCommand}" Padding="8,2" Margin="4,0,0,0" AutomationProperties.Name="Remove capture image"/>
                                <Button DockPanel.Dock="Right" Content="העלה תמונה" Command="{Binding PickCreateImageCommand}" Padding="8,2" Margin="4,0,0,0" AutomationProperties.Name="Upload capture image"/>
                                <TextBox Text="{Binding NewWorkspaceImagePath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Capture card image path" ToolTip="Full path of the uploaded image"/></DockPanel>
                            <TextBlock Text="Only the ticked items on the right are added." Foreground="Gray" FontSize="11" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding CreateError}" Foreground="#9B3030" TextWrapping="Wrap" FlowDirection="RightToLeft"/><Button Content="Create workspace from capture" Command="{Binding CaptureCreateCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="10,2" AutomationProperties.Name="Create workspace from capture"/>
                        </StackPanel>

                        <DockPanel Visibility="{Binding IsCapturePick, Converter={StaticResource B2V}}">
                            <TextBlock DockPanel.Dock="Top" Text="סביבה קיימת" FontWeight="SemiBold"/>
                            <TextBox DockPanel.Dock="Top" Margin="0,4,0,4" Text="{Binding CaptureSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Capture workspace search"/>
                            <ListBox ItemsSource="{Binding CaptureWorkspaceResults}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.CapturePickWorkspaceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="6,2"
                                                AutomationProperties.Name="{Binding Name, StringFormat='Pick workspace {0}'}">
                                            <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding EffectiveCategory}" Foreground="Gray" FontSize="11"/></StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <DockPanel x:Name="CaptureDropZone" Visibility="{Binding IsCaptureSide, Converter={StaticResource B2V}}" AllowDrop="True" Background="Transparent" Drop="CaptureDropZone_Drop" DragOver="CaptureDropZone_DragOver">
                            <DockPanel DockPanel.Dock="Top">
                                <Button DockPanel.Dock="Left" Content="חזור" Command="{Binding CaptureBackCommand}" Padding="8,1" Margin="0,0,6,0" FontSize="11" AutomationProperties.Name="Capture back"/>
                                <Button DockPanel.Dock="Right" Content="שמור" Command="{Binding CaptureSaveCommand}" Padding="12,2" AutomationProperties.Name="Capture save"/>
                                <TextBlock Text="{Binding CaptureWorkspaceName}" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.AutomationId="CaptureTargetWorkspace" AutomationProperties.Name="{Binding CaptureWorkspaceName}"/>
                            </DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Drag items here or use the add button. Nothing is saved until שמור." Foreground="Gray" FontSize="11" Margin="0,2,0,4"/>
                            <ListBox DockPanel.Dock="Top" MaxHeight="130" ItemsSource="{Binding CaptureWorkspaceItems}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Saved items in the workspace">
                                <ListBox.ItemTemplate>
                                    <DataTemplate><StackPanel><DockPanel><local:TargetIcon Target="{Binding Target}" ItemType="{Binding Type}" Margin="0,0,5,0"/><TextBlock><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding Group, Mode=OneWay}" Foreground="Gray"/></TextBlock></DockPanel><TextBlock Text="{Binding Target}" Foreground="Gray" FontSize="11"/></StackPanel></DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock DockPanel.Dock="Top" Text="Added, not saved yet" FontWeight="SemiBold" Margin="0,6,0,2"/>
                            <ListBox ItemsSource="{Binding StagedRows}" HorizontalContentAlignment="Stretch" ScrollViewer.CanContentScroll="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Added items not saved yet">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,2" Focusable="True" KeyboardNavigation.IsTabStop="True" ToolTip="פעולות האייטם: קליק ימני, Menu או Shift+F10" ContextMenuOpening="RowContextMenu_Opening" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="Staged item row">
                                            <StackPanel.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="מחיקה" Command="{Binding PlacementTarget.Tag.RemoveStagedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                            <MenuItem Header="העתק כתובת" Command="{Binding PlacementTarget.Tag.StagedCopyAddressCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                            <MenuItem Header="עריכת כתובת" Command="{Binding PlacementTarget.Tag.StagedEditAddressCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                            <MenuItem Header="פתח באמצעות" Command="{Binding PlacementTarget.Tag.StagedOpenWithCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}">
                                                                <MenuItem.Style><Style TargetType="MenuItem"><Style.Triggers><DataTrigger Binding="{Binding IsProgram}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></MenuItem.Style>
                                                            </MenuItem>
                                                            <Separator/><MenuItem Header="הזז למעלה" Command="{Binding PlacementTarget.Tag.StagedMoveUpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                            <MenuItem Header="הזז למטה" Command="{Binding PlacementTarget.Tag.StagedMoveDownCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                            <MenuItem Header="שיתוף לסביבה אחרת" IsEnabled="False" Visibility="Collapsed"/>
                                                        </ContextMenu>
                                                    </StackPanel.ContextMenu>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="✕" Padding="6,0" AutomationProperties.Name="{Binding OriginalName, StringFormat='Remove added {0}'}"
                                                        Command="{Binding DataContext.RemoveStagedCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                <Button DockPanel.Dock="Right" Content="עריכה" Click="EditStaged_Click" Padding="6,0" Margin="0,0,4,0" AutomationProperties.Name="{Binding OriginalName, StringFormat='Edit added {0}'}"
                                                        Command="{Binding DataContext.EditStagedCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                <StackPanel>
                                                    <DockPanel><local:TargetIcon Target="{Binding Target}" ItemType="{Binding Type}" Margin="0,0,5,0"/><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="StagedItemName"/><TextBlock Text="{Binding Group}" Foreground="Gray" Margin="6,0,0,0"/></DockPanel>
                                                    <TextBlock Text="{Binding Target}" Foreground="Gray" FontSize="11" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="StagedItemAddress"/>
                                                </StackPanel>
                                            </DockPanel>
                                            <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource B2V}}" Margin="0,4,0,0" AutomationProperties.Name="Staged item editor">
                                                <Button Content="סיום עריכה" Click="DoneStaged_Click" HorizontalAlignment="Right" Padding="6,0" AutomationProperties.Name="Done editing added item"
                                                        Command="{Binding DataContext.CloseStagedEditCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                <TextBlock Text="Name"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Added item name"/>
                                                <TextBlock Text="Description" Margin="0,2,0,0"/><TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" AutomationProperties.Name="Added item description"/>
                                                <TextBlock Text="Address" Margin="0,2,0,0"/><TextBox Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Added item address"/>
                                                <TextBlock Text="Open with" Margin="0,2,0,0"/><TextBox Text="{Binding OpenWith, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Added item open with" ToolTip="Optional: full path to the program/browser to open this item with"/>
                                                <TextBlock Text="Changes stay here until workspace Save." Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Grid>

                    <!-- right: the capture list (default details only; no actions, no editing) -->
                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Text="Open now" FontWeight="SemiBold"/>
                        <TextBlock DockPanel.Dock="Top" Text="סורק מה פתוח עכשיו..." Foreground="Gray" Margin="0,2,0,2" Visibility="{Binding IsScanning, Converter={StaticResource B2V}}"/>
                        <Button DockPanel.Dock="Top" Content="{Binding CaptureAddLabel}" Command="{Binding CaptureAddCommand}" HorizontalAlignment="Left" Margin="0,4,0,4" Padding="10,2" AutomationProperties.Name="{Binding CaptureAddLabel}"
                                Visibility="{Binding IsCaptureSide, Converter={StaticResource B2V}}"/>
                        <TextBlock DockPanel.Dock="Top" Text="Nothing open was detected" Foreground="Gray" Visibility="{Binding CaptureEmpty, Converter={StaticResource B2V}}"/>
                        <ListBox x:Name="CaptureList" ItemsSource="{Binding CaptureRows}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 PreviewMouseLeftButtonDown="CaptureList_PreviewMouseLeftButtonDown" PreviewMouseMove="CaptureList_PreviewMouseMove" AutomationProperties.Name="Open now list">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding Label}">
                                        <StackPanel><DockPanel><local:TargetIcon Target="{Binding Target}" ItemType="{Binding Type}" Margin="0,0,5,0"/><TextBlock><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding Group, Mode=OneWay}" Foreground="Gray"/><Run Text="{Binding BrowserSuffix, Mode=OneWay}" Foreground="Gray"/></TextBlock></DockPanel>
                                            <TextBlock Text="{Binding Target}" Foreground="Gray" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </Grid>

        <!-- duplicate warning for ONE dragged item -->
        <Grid Grid.RowSpan="3" Visibility="{Binding CaptureDupSinglePending, Converter={StaticResource B2V}}" Background="#66000000">
            <Border Background="White" Padding="16" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="320" MaxWidth="480">
                <StackPanel>
                    <TextBlock Text="{Binding CaptureDupSingleMessage}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Add anyway" Command="{Binding ConfirmCaptureDupSingleCommand}" Padding="12,2" AutomationProperties.Name="Capture duplicate add anyway"/>
                        <Button Content="Cancel" Command="{Binding CancelCaptureDupSingleCommand}" Padding="12,2" Margin="8,0,0,0" AutomationProperties.Name="Capture duplicate cancel"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ONE grouped dialog for the duplicates of an add-all / add-selected -->
        <Grid Grid.RowSpan="3" Visibility="{Binding CaptureDupGroupPending, Converter={StaticResource B2V}}" Background="#66000000">
            <Border Background="White" Padding="16" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="340" MaxWidth="520">
                <StackPanel>
                    <TextBlock Text="Already in this workspace" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,6"/>
                    <TextBlock Text="Tick the ones you want to add again as separate instances." TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding CaptureDupChoices}">
                        <ItemsControl.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Label}" AutomationProperties.Name="{Binding Label}" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Add ticked" Command="{Binding ConfirmCaptureDupGroupCommand}" Padding="12,2" AutomationProperties.Name="Capture duplicates add ticked"/>
                        <Button Content="Skip duplicates" Command="{Binding CancelCaptureDupGroupCommand}" Padding="12,2" Margin="8,0,0,0" AutomationProperties.Name="Capture duplicates skip"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ empty-workspace dialog (דיאלוג סביבת עבודה ריקה) ============ -->
        <Grid Grid.RowSpan="3" Visibility="{Binding EmptyWorkspaceOpen, Converter={StaticResource B2V}}" Background="#66000000">
            <Border Background="White" Padding="16" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="300">
                <StackPanel>
                    <TextBlock Text="סביבת עבודה ריקה" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,6"/>
                    <TextBlock Text="This workspace has no items yet." TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="עבור לפרטי הסביבה" Command="{Binding GoToDetailsCommand}" Padding="12,2"/>
                        <Button Content="Close" Command="{Binding CloseEmptyWorkspaceCommand}" Padding="12,2" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ default-env replace confirm (דיאלוג אישור החלפת ברירת מחדל, approved mock home-default-confirm 22.11):
             overlay #17243C44, white card radius 7, shadow 0 18px 80px #18243D30, width 560. Cancel/✕/outside change nothing. ============ -->
        <Grid Grid.RowSpan="3" Visibility="{Binding DefaultConfirmOpen, Converter={StaticResource B2V}}" Background="#4417243C">
            <Border Background="White" CornerRadius="7" Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="80" ShadowDepth="18" Direction="270" Color="#18243D" Opacity="0.19"/>
                </Border.Effect>
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Content="✕" Command="{Binding CancelDefaultReplaceCommand}" Style="{StaticResource QuietTextButton}" FontSize="13" AutomationProperties.Name="Cancel default-env replace"/>
                        <TextBlock DockPanel.Dock="Right" Text="הגדרת סביבת ברירת מחדל" FontSize="11" Foreground="#626B79" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <TextBlock Text="כבר מוגדרת סביבת ברירת מחדל" FontSize="20" FontWeight="SemiBold" Foreground="#222833" Margin="0,14,0,0"/>
                    <TextBlock Text="{Binding DefaultConfirmBody}" FontSize="13" Foreground="#5B6576" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    <Border Background="#EEF3FB" BorderBrush="#CED8E9" BorderThickness="1" CornerRadius="5" Padding="12,8" Margin="0,14,0,0">
                        <TextBlock Text="{Binding DefaultConfirmNotice}" FontSize="12" Foreground="#3F526D" TextWrapping="Wrap"/>
                    </Border>
                    <Border Height="1" Background="#E4E8EF" Margin="0,16"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="כן, הגדר כברירת מחדל" Style="{StaticResource PrimaryActionButton}" Command="{Binding ConfirmDefaultReplaceCommand}" AutomationProperties.Name="Confirm default-env replace"/>
                        <Button Content="ביטול" Command="{Binding CancelDefaultReplaceCommand}" Margin="10,0,0,0" Padding="16,7" FontSize="13"
                                Background="White" BorderBrush="#C5CAD4" BorderThickness="1" Cursor="Hand" AutomationProperties.Name="Cancel default-env replace button"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ address popup (פופאפ עריכת כתובת) ============ -->
        <Grid Grid.RowSpan="3" Visibility="{Binding AddressEditOpen, Converter={StaticResource B2V}}" Background="#66000000">
            <Border Background="White" Padding="16" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="420">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="✕" Command="{Binding CloseAddressEditCommand}" Padding="6,0" AutomationProperties.Name="Close address edit" ToolTip="Close"/>
                        <TextBlock Text="עריכת כתובת" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBox Text="{Binding EditAddress, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Full address"/>
                    <TextBlock Text="{Binding AddressError}" Foreground="#9B3030" TextWrapping="Wrap" FlowDirection="RightToLeft"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="העתק" Command="{Binding CopyFullAddressCommand}" Padding="12,2" AutomationProperties.Name="Copy full address"/>
                        <Button Content="שמור" Command="{Binding SaveAddressCommand}" Padding="12,2" Margin="8,0,0,0"
                                Visibility="{Binding AddressEditDirty, Converter={StaticResource B2V}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ open-with popup (פופאפ פתח באמצעות) ============ -->
        <Grid Grid.RowSpan="3" Visibility="{Binding OpenWithOpen, Converter={StaticResource B2V}}" Background="#66000000">
            <Border Background="White" Padding="16" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="420">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="✕" Command="{Binding CloseOpenWithCommand}" Padding="6,0" AutomationProperties.Name="Close open with" ToolTip="Close"/>
                        <TextBlock Text="פתח באמצעות" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="{Binding OpenWithLabel}" Foreground="Gray" Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <TextBox Text="{Binding OpenWithProgram, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Program path"/>
                    <CheckBox Content="הגדר כברירת מחדל" IsChecked="{Binding OpenWithSetDefault}" Margin="0,6,0,0" AutomationProperties.Name="Set as default"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="פתח" Command="{Binding OpenWithGoCommand}" Padding="12,2" AutomationProperties.Name="Open with chosen program"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ existing-resource picker (בחר מסביבות קיימות): items only, four type buttons,
             original resource names (site address under the name), search, usage-count sort ============ -->
        <Grid Grid.RowSpan="3" Visibility="{Binding PickerOpen, Converter={StaticResource B2V}}" Background="#66000000">
            <Border Background="White" Padding="16" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="460">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="✕" Command="{Binding ClosePickerCommand}" Padding="6,0" AutomationProperties.Name="Close resource picker" ToolTip="Close"/>
                        <TextBlock Text="בחר מסביבות קיימות" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding PickerTypes}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Button Padding="10,2" Margin="0,0,4,0" Command="{Binding DataContext.PickTypeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                    Content="{Binding}" AutomationProperties.Name="Picker type"/>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox Text="{Binding PickerSearch, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" AutomationProperties.Name="Search resources" ToolTip="Search"/>
                    <ListBox ItemsSource="{Binding PickerRows}" MaxHeight="200" Margin="0,6,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Resource list">
                        <ListBox.ItemTemplate><DataTemplate>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="בחר" Padding="8,0" Margin="4,0,0,0" AutomationProperties.Name="Pick resource"
                                        Command="{Binding DataContext.PickResourceCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal"><local:TargetIcon Target="{Binding Target}" ItemType="{Binding Type}" Margin="0,0,5,0"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center"/></StackPanel>
                                    <!-- sites also show the address under the name (settled); other types show the name only -->
                                    <TextBlock Text="{Binding Target}" Foreground="Gray" FontSize="11" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
                                            <DataTrigger Binding="{Binding Type}" Value="Link"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                        </Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ card design popup (פופאפ עיצוב כרטיס) ============ -->
        <Grid Grid.RowSpan="3" Visibility="{Binding DesignEditOpen, Converter={StaticResource B2V}}" Background="#66000000">
            <Border Background="White" Padding="16" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="440">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="✕" Command="{Binding CloseDesignCommand}" Padding="6,0" AutomationProperties.Name="Close card design" ToolTip="Close"/>
                        <TextBlock Text="עיצוב כרטיס" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                    </DockPanel>
                    <!-- preview: same color/frame rule as the card, bound to the unsaved values -->
                    <TextBlock Text="{Binding DesignError}" Foreground="#9B3030" TextWrapping="Wrap" FlowDirection="RightToLeft"/><local:PreviewBorder Height="90" CornerRadius="4" Margin="0,0,0,8" BorderBrush="{Binding DesignColor, Converter={StaticResource ColorBrush}}"
                            AutomationProperties.Name="Card design preview">
                        <local:PreviewBorder.BorderThickness>
                            <Binding Path="DesignImagePath" Converter="{StaticResource FrameThickness}"/>
                        </local:PreviewBorder.BorderThickness>
                        <local:PreviewBorder.Background>
                            <MultiBinding Converter="{StaticResource CardBrush}">
                                <Binding Path="DesignColor"/>
                                <Binding Path="DesignImagePath"/>
                            </MultiBinding>
                        </local:PreviewBorder.Background>
                    </local:PreviewBorder>
                    <TextBlock Text="צבע" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBox Text="{Binding DesignColor, UpdateSourceTrigger=PropertyChanged}" Width="90" AutomationProperties.Name="Card color" ToolTip="#RRGGBB"/>
                        <ItemsControl ItemsSource="{Binding DesignPalette}" Margin="8,0,0,0">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Button Width="22" Height="22" Margin="0,0,4,0" BorderBrush="Gray" BorderThickness="1"
                                        Background="{Binding ., Converter={StaticResource ColorBrush}}"
                                        Command="{Binding DataContext.ApplyPaletteColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                        ToolTip="{Binding}"/>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <TextBlock Text="תמונת רקע" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    <DockPanel Margin="0,4,0,0">
                        <Button DockPanel.Dock="Right" Content="הסר תמונה" Command="{Binding RemoveImageCommand}" Padding="8,2" Margin="4,0,0,0" AutomationProperties.Name="Remove card image"/>
                        <Button DockPanel.Dock="Right" Content="העלה תמונה" Command="{Binding PickImageCommand}" Padding="8,2" Margin="4,0,0,0" AutomationProperties.Name="Upload card image"/>
                        <TextBox Text="{Binding DesignImagePath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Card image path" ToolTip="Full path of the uploaded image"/>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="שמור" Command="{Binding SaveDesignCommand}" Padding="12,2"
                                Visibility="{Binding DesignDirty, Converter={StaticResource B2V}}" AutomationProperties.Name="Save card design"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ category popup (פופאפ עריכת קטגוריה) ============ -->
        <Grid Grid.RowSpan="3" Visibility="{Binding CategoryEditOpen, Converter={StaticResource B2V}}" Background="#66000000">
            <Border Background="White" Padding="16" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="440">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="✕" Command="{Binding CloseCategoryPopupCommand}" Padding="6,0" AutomationProperties.Name="Close category popup" ToolTip="Close"/>
                        <TextBlock Text="ערוך קטגוריה" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="{Binding CategoryError}" Foreground="#9B3030" TextWrapping="Wrap" FlowDirection="RightToLeft"/><TextBlock Text="{Binding CurrentCategoryName, StringFormat='Current: {0}'}" Foreground="Gray" Margin="0,0,0,4"/>
                    <ListBox ItemsSource="{Binding CategoryRows}" MaxHeight="180" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Category list">
                        <ListBox.ItemTemplate><DataTemplate>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="מחק" Padding="6,0" Margin="4,0,0,0" AutomationProperties.Name="Delete category"
                                        Command="{Binding DataContext.DeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}">
                                    <Button.Style><Style TargetType="Button"><Style.Triggers>
                                        <!-- base categories can never be edited or deleted (settled Nov 11) -->
                                        <DataTrigger Binding="{Binding IsBuiltIn}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    </Style.Triggers></Style></Button.Style>
                                </Button>
                                <Button DockPanel.Dock="Right" Content="ערוך" Padding="6,0" Margin="4,0,0,0" AutomationProperties.Name="Rename category"
                                        Command="{Binding DataContext.BeginRenameCategoryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}">
                                    <Button.Style><Style TargetType="Button"><Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBuiltIn}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    </Style.Triggers></Style></Button.Style>
                                </Button>
                                <Button DockPanel.Dock="Right" Content="בחר" Padding="6,0" Margin="4,0,0,0" AutomationProperties.Name="Pick category"
                                        Command="{Binding DataContext.PickCategoryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                <StackPanel Orientation="Horizontal"><local:TargetIcon Target="{Binding Target}" ItemType="{Binding Type}" Margin="0,0,5,0"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center"/></StackPanel>
                            </DockPanel>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <DockPanel Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" Content="הוסף קטגוריה" Command="{Binding AddCategoryCommand}" Padding="8,2" Margin="4,0,0,0" AutomationProperties.Name="Add category"/>
                        <TextBox Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="New category name" ToolTip="Name of a new custom category"/>
                    </DockPanel>
                    <!-- rename a custom category -->
                    <StackPanel Margin="0,8,0,0" Visibility="{Binding RenameCategoryOpen, Converter={StaticResource B2V}}">
                        <TextBlock Text="Rename category" FontWeight="SemiBold"/>
                        <DockPanel Margin="0,4,0,0">
                            <Button DockPanel.Dock="Right" Content="בטל" Command="{Binding CancelRenameCategoryCommand}" Padding="8,2" Margin="4,0,0,0"/>
                            <Button DockPanel.Dock="Right" Content="שמור" Command="{Binding SaveRenameCategoryCommand}" Padding="8,2" Margin="4,0,0,0" AutomationProperties.Name="Save category rename"/>
                            <TextBox Text="{Binding RenameCategoryText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Rename category text"/>
                        </DockPanel>
                    </StackPanel>
                    <!-- deletion warning: one workspace shown directly; several behind a list button (settled Nov 11) -->
                    <Border Margin="0,8,0,0" BorderBrush="DarkOrange" BorderThickness="1" Padding="8"
                            Visibility="{Binding CategoryDeletePending, Converter={StaticResource B2V}}">
                        <StackPanel>
                            <TextBlock Text="{Binding CategoryDeleteMessage}" TextWrapping="Wrap"/>
                            <!-- shown only for several assigned workspaces: with one, the warning shows it directly (the list is already visible) -->
                            <Button Content="הצג רשימה" Command="{Binding ShowCategoryDeleteListCommand}" Padding="8,2" Margin="0,6,0,0" HorizontalAlignment="Left"
                                    AutomationProperties.Name="Show assigned workspaces">
                                <Button.Style><Style TargetType="Button"><Style.Triggers>
                                    <DataTrigger Binding="{Binding CategoryDeleteListShown}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                </Style.Triggers></Style></Button.Style>
                            </Button>
                            <ListBox ItemsSource="{Binding CategoryDeleteWorkspaces}" MaxHeight="90" Margin="0,4,0,0" AutomationProperties.Name="Assigned workspaces"
                                     Visibility="{Binding CategoryDeleteListShown, Converter={StaticResource B2V}}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button Content="מחק והעבר" Command="{Binding ConfirmCategoryDeleteCommand}" Padding="12,2" AutomationProperties.Name="Confirm category delete"/>
                                <Button Content="בטל" Command="{Binding CancelCategoryDeleteCommand}" Padding="12,2" Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ unsaved-changes exit dialog (דיאלוג יציאה עם שינויים שלא נשמרו) ============ -->
        <Grid Grid.RowSpan="4" Panel.ZIndex="100" Visibility="{Binding UnsavedOpen, Converter={StaticResource B2V}}" Background="#4417243C">
            <Grid.InputBindings><KeyBinding Key="Escape" Command="{Binding CloseUnsavedCommand}"/></Grid.InputBindings>
            <Border Background="White" Padding="28" CornerRadius="7" Width="560" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="RightToLeft" KeyboardNavigation.TabNavigation="Cycle">
                <StackPanel>
                    <DockPanel FlowDirection="LeftToRight" Height="16" Margin="0,0,0,18">
                        <Button DockPanel.Dock="Left" Content="×" Command="{Binding CloseUnsavedCommand}" Style="{StaticResource QuietTextButton}" FontSize="14" Width="12" AutomationProperties.Name="Back to editing" ToolTip="חזרה לעריכה"/>
                        <TextBlock Text="{Binding UnsavedContextLabel}" FontSize="12" Foreground="#667388" TextAlignment="Right"/>
                    </DockPanel>
                    <TextBlock Text="יש שינויים שלא נשמרו" FontWeight="SemiBold" FontSize="23" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding UnsavedContextMessage}" TextWrapping="Wrap" FontSize="13" Foreground="#5B6576" LineHeight="25" LineStackingStrategy="BlockLineHeight"/>
                    <TextBlock Text="אם תצא בלי לשמור, השינויים יאבדו." FontSize="13" Foreground="#5B6576" LineHeight="25" LineStackingStrategy="BlockLineHeight"/>
                    <Border BorderBrush="#E4E8EF" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,20,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="שמור וצא" Command="{Binding SaveAndExitCommand}" Style="{StaticResource PrimaryActionButton}" Padding="16,8" MinHeight="38"/>
                            <Button Content="צא בלי לשמור" Command="{Binding ExitWithoutSavingCommand}" Style="{StaticResource HomeToolbarButton}" MinWidth="122" MinHeight="38" Margin="8,0,0,0"/>
                            <Button x:Name="UnsavedCancelButton" Content="ביטול" Command="{Binding CloseUnsavedCommand}" Style="{StaticResource HomeToolbarButton}" MinWidth="69" MinHeight="38" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
        <Grid Grid.RowSpan="3" Panel.ZIndex="30" Background="#66000000" Visibility="{Binding SelectionPending, Converter={StaticResource B2V}}">
            <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1" Padding="16" Margin="20" MaxWidth="620" MaxHeight="340" VerticalAlignment="Center" FlowDirection="RightToLeft">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10"><Button DockPanel.Dock="Left" Content="✕" Command="{Binding CancelOpenCommand}" Margin="0,0,12,0" AutomationProperties.Name="Close opening selection"/><TextBlock Text="מה לפתוח בסביבה?" FontSize="18" FontWeight="SemiBold"/></DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0"><Button Content="שגר" Command="{Binding ConfirmSelectionCommand}" Padding="16,4" AutomationProperties.Name="Confirm opening selection"/><Button Content="ביטול" Command="{Binding CancelOpenCommand}" Padding="12,4" Margin="8,0"/></StackPanel>
                    <ListBox ItemsSource="{Binding OpeningChoices}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Opening selection">
                        <ListBox.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding Name}"><DockPanel Margin="0,3"><local:TargetIcon Target="{Binding Target}" ItemType="{Binding Type}" Margin="0,0,8,0"/><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Target}" Foreground="Gray" FontSize="11" TextWrapping="Wrap" FlowDirection="LeftToRight"/></StackPanel></DockPanel></CheckBox></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
        <Grid Grid.RowSpan="3" Panel.ZIndex="30" Background="#66000000" Visibility="{Binding OpenDecisionPending, Converter={StaticResource B2V}}">
            <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1" Padding="16" Margin="20" MaxWidth="620" MaxHeight="340" VerticalAlignment="Center" FlowDirection="RightToLeft">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8"><DockPanel><Button DockPanel.Dock="Left" Content="✕" Command="{Binding CancelOpenCommand}" Margin="0,0,12,0" AutomationProperties.Name="Close confirmed duplicates"/><TextBlock Text="פריטים שזוהו כפתוחים" FontSize="18" FontWeight="SemiBold"/></DockPanel><TextBlock Text="סמנו רק את מה שתרצו לפתוח שוב. עדיין לא נשלחה בקשת פתיחה." TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock Text="אתרים מזוהים לפי שורת הכתובת, גם אם הוקלדה כתובת שטרם נפתחה." TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12" Foreground="#585254" AutomationProperties.Name="Browser observation limitation"/></StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0"><Button Content="המשך לפתיחה" Command="{Binding ConfirmOpenAnywayCommand}" Padding="12,4" AutomationProperties.Name="Confirm duplicate choices"/><Button Content="חזרה לבחירה" Command="{Binding BackToOpeningSelectionCommand}" Padding="12,4" Margin="8,0" Visibility="{Binding CanBackToOpeningSelection, Converter={StaticResource B2V}}"/><Button Content="ביטול" Command="{Binding CancelOpenCommand}" Padding="12,4"/></StackPanel>
                    <ListBox ItemsSource="{Binding ReopenChoices}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Confirmed duplicate list"><ListBox.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding Name}"><DockPanel Margin="0,3"><local:TargetIcon Target="{Binding Target}" ItemType="{Binding Type}" Margin="0,0,8,0"/><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Target}" Foreground="Gray" FontSize="11" TextWrapping="Wrap" FlowDirection="LeftToRight"/></StackPanel></DockPanel></CheckBox></DataTemplate></ListBox.ItemTemplate></ListBox>
                </DockPanel>
            </Border>
        </Grid>
        <Grid Grid.RowSpan="3" Panel.ZIndex="30" Background="#66000000" Visibility="{Binding LastResultsOpen, Converter={StaticResource B2V}}">
            <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1" Padding="16" Margin="20" MaxWidth="660" MaxHeight="340" VerticalAlignment="Center" FlowDirection="RightToLeft">
                <DockPanel><DockPanel DockPanel.Dock="Top" Margin="0,0,0,10"><Button DockPanel.Dock="Left" Content="✕" Command="{Binding CloseLastOpeningResultsCommand}" Margin="0,0,12,0" AutomationProperties.Name="Close last opening results"/><TextBlock Text="תוצאות הפתיחה האחרונות" FontSize="18" FontWeight="SemiBold"/></DockPanel>
                    <ListBox ItemsSource="{Binding LastOpeningResults}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Opening results"><ListBox.ItemTemplate><DataTemplate><DockPanel Margin="0,4"><local:TargetIcon Target="{Binding Target}" ItemType="{Binding Type}" Margin="0,0,8,0" VerticalAlignment="Top"/><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap"/><Expander Header="פרטים טכניים" Margin="0,3,0,0"><StackPanel><TextBlock Text="{Binding TechnicalDetails}" TextWrapping="Wrap" FlowDirection="LeftToRight"/><Button Content="העתק פרטים" Command="{Binding DataContext.CopyTechnicalDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding TechnicalDetails}" HorizontalAlignment="Right"/></StackPanel></Expander></StackPanel></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
                </DockPanel>
            </Border>
        </Grid>
        <Border Grid.RowSpan="3" Panel.ZIndex="20" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="16" Padding="12" Width="480" MaxHeight="250" Background="#FFF9EB" BorderBrush="#B48629" BorderThickness="1" Visibility="{Binding ToastVisible, Converter={StaticResource B2V}}" FlowDirection="RightToLeft" AutomationProperties.Name="Notification">
            <StackPanel><DockPanel><Button DockPanel.Dock="Left" Content="✕" Command="{Binding DismissToastCommand}" AutomationProperties.Name="Dismiss notification"/><TextBlock Text="{Binding ToastMessage}" TextWrapping="Wrap" Margin="0,0,8,0"/></DockPanel><Button Content="תוצאות הפתיחה" Command="{Binding ToastDetailsCommand}" HorizontalAlignment="Right" Margin="0,5,0,0" Visibility="{Binding ToastHasOpeningResults, Converter={StaticResource B2V}}"/><Expander Header="פרטים טכניים"><StackPanel><TextBox Text="{Binding ToastTechnicalDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="110" VerticalScrollBarVisibility="Auto" FlowDirection="LeftToRight"/><Button Content="העתק פרטים" Command="{Binding CopyTechnicalDetailsCommand}" CommandParameter="{Binding ToastTechnicalDetails}" HorizontalAlignment="Right"/></StackPanel></Expander></StackPanel>
        </Border>
            <Grid Grid.RowSpan="3" Panel.ZIndex="20"
                  Visibility="{Binding InSettings, Converter={StaticResource B2V}}">
                <local:SettingsView DataContext="{Binding Updates, RelativeSource={RelativeSource AncestorType=Window}}"/>
            </Grid>
            <Grid Grid.RowSpan="3" Panel.ZIndex="20"
                  Visibility="{Binding InGlobalEnv, Converter={StaticResource B2V}}">
                <local:GlobalEnvView DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"/>
            </Grid>
    </Grid>
    </Border>
</Window>
