<Window x:Class="StartApp.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Start-app" Height="480" Width="760">
    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Margin="0,8,0,0" TextWrapping="Wrap"/>
        <StackPanel DockPanel.Dock="Left" Width="220" Margin="0,0,8,0">
            <ListBox ItemsSource="{Binding Workspaces}" SelectedItem="{Binding Selected}" DisplayMemberPath="Name" Height="300"/>
            <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0"/>
            <Button Content="Create workspace" Command="{Binding CreateWorkspaceCommand}" Margin="0,4,0,0"/>
            <Button Content="Delete workspace" Command="{Binding DeleteWorkspaceCommand}" Margin="0,4,0,0"/>
        </StackPanel>
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                <Button Content="Open workspace" Command="{Binding OpenWorkspaceCommand}"/>
                <ComboBox ItemsSource="{Binding ItemTypes}" SelectedItem="{Binding NewItemType}" Width="90" Margin="16,0,0,0"/>
                <TextBox Text="{Binding NewTarget, UpdateSourceTrigger=PropertyChanged}" Width="300" Margin="4,0,0,0"/>
                <Button Content="Add" Command="{Binding AddItemCommand}" Margin="4,0,0,0"/>
            </StackPanel>
            <ListView ItemsSource="{Binding Items}" Margin="0,8,0,0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="160"/>
                        <GridViewColumn Header="Type" DisplayMemberBinding="{Binding Type}" Width="70"/>
                        <GridViewColumn Header="Target" DisplayMemberBinding="{Binding Target}" Width="240"/>
                        <GridViewColumn Header="">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Remove"
                                            Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </DockPanel>
    </DockPanel>
</Window>
