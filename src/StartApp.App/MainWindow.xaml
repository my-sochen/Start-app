<Window x:Class="StartApp.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Start-app" Height="520" Width="860" MinWidth="720" MinHeight="360">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <CollectionViewSource x:Key="ItemsView" Source="{Binding Items}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </Window.Resources>
    <Grid>
        <DockPanel Margin="8">
            <StackPanel DockPanel.Dock="Bottom" Visibility="{Binding ShowOpenPanel, Converter={StaticResource B2V}}" Margin="0,8,0,0">
                <TextBlock Text="Problems found before opening:" FontWeight="SemiBold" Visibility="{Binding OpenDecisionPending, Converter={StaticResource B2V}}"/>
                <ListBox ItemsSource="{Binding OpenProblems}" MaxHeight="64" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Visibility="{Binding OpenDecisionPending, Converter={StaticResource B2V}}"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Content="{Binding ConfirmLabel}" Command="{Binding ConfirmOpenAnywayCommand}" Padding="8,2" Visibility="{Binding OpenDecisionPending, Converter={StaticResource B2V}}"/>
                    <Button Content="Cancel" Command="{Binding CancelOpenCommand}" Padding="8,2" Margin="8,0,0,0"/>
                </StackPanel>
            </StackPanel>
            <ListBox DockPanel.Dock="Bottom" ItemsSource="{Binding OpenReport}" MaxHeight="64" Margin="0,8,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.Style><Style TargetType="ListBox"><Style.Triggers><DataTrigger Binding="{Binding OpenReport.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ListBox.Style>
            </ListBox>
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Margin="0,8,0,0" TextWrapping="Wrap"/>
            <DockPanel DockPanel.Dock="Left" Width="220" Margin="0,0,8,0">
                <Button DockPanel.Dock="Bottom" Content="Delete workspace" Command="{Binding DeleteWorkspaceCommand}" Margin="0,4,0,0"/>
                <Button DockPanel.Dock="Bottom" Content="Create workspace" Command="{Binding CreateWorkspaceCommand}" Margin="0,4,0,0"/>
                <TextBox DockPanel.Dock="Bottom" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" AutomationProperties.Name="Workspace name"/>
                <ListBox ItemsSource="{Binding Workspaces}" SelectedItem="{Binding Selected}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding EffectiveCategory}" Foreground="Gray" FontSize="11"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <Button DockPanel.Dock="Left" Content="Open workspace" Command="{Binding OpenWorkspaceCommand}" Padding="8,2"/>
                    <Button DockPanel.Dock="Right" Content="Add" Command="{Binding AddItemCommand}" Margin="4,0,0,0" Padding="12,2"/>
                    <ComboBox DockPanel.Dock="Left" ItemsSource="{Binding ItemTypes}" SelectedItem="{Binding NewItemType}" Width="90" Margin="16,0,0,0"/>
                    <TextBox Text="{Binding NewTarget, UpdateSourceTrigger=PropertyChanged}" MinWidth="120" Margin="4,0,0,0"/>
                </DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,4,0,0">
                    <TextBlock DockPanel.Dock="Left" Text="Name (optional)" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding NewItemName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Item name"/>
                </DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,4,0,0">
                    <TextBlock DockPanel.Dock="Left" Text="Description (optional)" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" AutomationProperties.Name="Item description"/>
                </DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding DuplicatePending, Converter={StaticResource B2V}}">
                    <TextBlock Text="{Binding DuplicateMessage}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="480"/>
                    <Button Content="Add anyway" Command="{Binding ConfirmDuplicateCommand}" Padding="8,2" Margin="8,0,0,0"/>
                    <Button Content="Cancel" Command="{Binding CancelDuplicateCommand}" Padding="8,2" Margin="4,0,0,0"/>
                </StackPanel>
                <Grid DockPanel.Dock="Top" Margin="8,8,8,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Name" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="Type" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="2" Text="Target" FontWeight="SemiBold"/>
                </Grid>
                <ListView ItemsSource="{Binding Source={StaticResource ItemsView}}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,6,0,2"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Type}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Target}" ToolTip="{Binding Target}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Text="{Binding Description}" ToolTip="{Binding Description}" Foreground="Gray" FontStyle="Italic" TextTrimming="CharacterEllipsis" Margin="0,0,8,2">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers>
                                        <DataTrigger Binding="{Binding Description}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        <DataTrigger Binding="{Binding Description}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    </Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                                <Button Grid.Row="0" Grid.Column="3" Content="Remove"
                                        Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </DockPanel>
        </DockPanel>
        <Grid Visibility="{Binding EmptyWorkspaceOpen, Converter={StaticResource B2V}}" Background="#66000000">
            <Border Background="White" Padding="16" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="280">
                <StackPanel>
                    <TextBlock Text="Empty workspace" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,6"/>
                    <TextBlock Text="This workspace has no items yet." TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Button Content="Close" Command="{Binding CloseEmptyWorkspaceCommand}" Padding="12,2" HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
