<Window x:Class="StartApp.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Start-app" Height="560" Width="900" MinWidth="720" MinHeight="400">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <CollectionViewSource x:Key="ItemsView" Source="{Binding Items}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </Window.Resources>
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============ OVERVIEW: workspace cards + create form ============ -->
            <DockPanel Margin="8" Visibility="{Binding InOverview, Converter={StaticResource B2V}}">
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <TextBlock Text="Create workspace" FontWeight="SemiBold"/>
                    <DockPanel Margin="0,4,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="Name" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Workspace name"/>
                    </DockPanel>
                    <DockPanel Margin="0,4,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="Description (optional)" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding NewWorkspaceDescription, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" AutomationProperties.Name="Workspace description"/>
                    </DockPanel>
                    <DockPanel Margin="0,4,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="Category" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="כללי" VerticalAlignment="Center" Foreground="Gray"/>
                        <TextBlock Text="(default; custom categories are a later feature)" VerticalAlignment="Center" Foreground="Gray" FontSize="11" Margin="6,0,0,0"/>
                    </DockPanel>
                    <Button Content="Create workspace" Command="{Binding CreateWorkspaceCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="10,2"/>
                </StackPanel>
                <ListBox ItemsSource="{Binding Workspaces}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2">
                                <Button DockPanel.Dock="Right" Content="Delete" Padding="8,2" Margin="4,0,0,0"
                                        Command="{Binding DataContext.DeleteWorkspaceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                <Button DockPanel.Dock="Right" Content="Open" Padding="8,2" Margin="4,0,0,0"
                                        Command="{Binding DataContext.OpenWorkspaceForCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                <Button Command="{Binding DataContext.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                        HorizontalContentAlignment="Left" Padding="6,2">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding EffectiveCategory}" Foreground="Gray" FontSize="11"/>
                                        <TextBlock Foreground="Gray" FontSize="11"><Run Text="Last opened: "/><Run Text="{Binding LastOpenedAt, ConverterCulture=en-US, StringFormat='{}{0:yyyy-MM-dd HH:mm}', TargetNullValue=never, FallbackValue=never}"/></TextBlock>
                                    </StackPanel>
                                </Button>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- ============ DETAILS: פרטי סביבה ============ -->
            <DockPanel Margin="8" Visibility="{Binding InDetails, Converter={StaticResource B2V}}">
                <DockPanel DockPanel.Dock="Top">
                    <Button DockPanel.Dock="Left" Content="Back" Command="{Binding BackCommand}" Padding="8,2"/>
                    <Button DockPanel.Dock="Right" Content="Open workspace" Command="{Binding OpenWorkspaceCommand}" Padding="8,2"/>
                    <TextBlock Text="{Binding CreatedAtText, StringFormat='Created: {0}'}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="Gray" Margin="0,0,10,0"/>
                </DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,6,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="Name" Width="80" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Workspace name"/>
                    </DockPanel>
                    <DockPanel Margin="0,4,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="Category" Width="80" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding EditCategory, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Workspace category"/>
                    </DockPanel>
                    <DockPanel Margin="0,4,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="Description" Width="80" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" AutomationProperties.Name="Workspace description"/>
                    </DockPanel>
                    <Button Content="Save" Command="{Binding SaveDetailsCommand}" HorizontalAlignment="Left" Margin="0,4,0,0" Padding="12,2"
                            Visibility="{Binding DetailsDirty, Converter={StaticResource B2V}}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,8,0,0" Visibility="{Binding ShowEmptyItemsMessage, Converter={StaticResource B2V}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="עדיין אין אייטמים בסביבה" VerticalAlignment="Center" FontStyle="Italic"/>
                        <Button Content="הוסף אייטם" Command="{Binding FocusAddCommand}" Padding="10,2" Margin="8,0,0,0"/>
                    </DockPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,8,0,0">
                    <DockPanel>
                        <ComboBox DockPanel.Dock="Left" ItemsSource="{Binding ItemTypes}" SelectedItem="{Binding NewItemType}" Width="90"/>
                        <Button DockPanel.Dock="Right" Content="Add" Command="{Binding AddItemCommand}" Margin="4,0,0,0" Padding="12,2"/>
                        <TextBox x:Name="TargetBox" Text="{Binding NewTarget, UpdateSourceTrigger=PropertyChanged}" MinWidth="120" Margin="4,0,0,0" AutomationProperties.Name="Item target"/>
                    </DockPanel>
                    <DockPanel Margin="0,4,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="Name (optional)" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding NewItemName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Item name"/>
                    </DockPanel>
                    <DockPanel Margin="0,4,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="Description (optional)" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" AutomationProperties.Name="Item description"/>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding DuplicatePending, Converter={StaticResource B2V}}">
                        <TextBlock Text="{Binding DuplicateMessage}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="480"/>
                        <Button Content="Add anyway" Command="{Binding ConfirmDuplicateCommand}" Padding="8,2" Margin="8,0,0,0"/>
                        <Button Content="Cancel" Command="{Binding CancelDuplicateCommand}" Padding="8,2" Margin="4,0,0,0"/>
                    </StackPanel>
                </StackPanel>
                <ListView ItemsSource="{Binding Source={StaticResource ItemsView}}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" Margin="0,8,0,0">
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,6,0,2"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Type}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Target}" ToolTip="{Binding Target}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Text="{Binding Description}" ToolTip="{Binding Description}" Foreground="Gray" FontStyle="Italic" TextTrimming="CharacterEllipsis" Margin="0,0,8,2">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers>
                                        <DataTrigger Binding="{Binding Description}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        <DataTrigger Binding="{Binding Description}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    </Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                                <Button Grid.Row="0" Grid.Column="3" Content="Remove"
                                        Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </DockPanel>

            <!-- shared bottom area: preflight panel, report, status -->
            <StackPanel Grid.Row="1" Margin="8,0,8,8">
                <StackPanel Visibility="{Binding ShowOpenPanel, Converter={StaticResource B2V}}" Margin="0,4,0,0">
                    <TextBlock Text="Problems found before opening:" FontWeight="SemiBold" Visibility="{Binding OpenDecisionPending, Converter={StaticResource B2V}}"/>
                    <ListBox ItemsSource="{Binding OpenProblems}" MaxHeight="64" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Visibility="{Binding OpenDecisionPending, Converter={StaticResource B2V}}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="{Binding ConfirmLabel}" Command="{Binding ConfirmOpenAnywayCommand}" Padding="8,2" Visibility="{Binding OpenDecisionPending, Converter={StaticResource B2V}}"/>
                        <Button Content="Cancel" Command="{Binding CancelOpenCommand}" Padding="8,2" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
                <ListBox ItemsSource="{Binding OpenReport}" MaxHeight="64" Margin="0,4,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.Style><Style TargetType="ListBox"><Style.Triggers><DataTrigger Binding="{Binding OpenReport.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ListBox.Style>
                </ListBox>
                <TextBlock Text="{Binding Status}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <!-- ============ empty-workspace dialog (דיאלוג סביבת עבודה ריקה) ============ -->
        <Grid Visibility="{Binding EmptyWorkspaceOpen, Converter={StaticResource B2V}}" Background="#66000000">
            <Border Background="White" Padding="16" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="300">
                <StackPanel>
                    <TextBlock Text="סביבת עבודה ריקה" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,6"/>
                    <TextBlock Text="This workspace has no items yet." TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="עבור לפרטי הסביבה" Command="{Binding GoToDetailsCommand}" Padding="12,2"/>
                        <Button Content="Close" Command="{Binding CloseEmptyWorkspaceCommand}" Padding="12,2" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ unsaved-changes exit dialog (דיאלוג יציאה עם שינויים שלא נשמרו) ============ -->
        <Grid Visibility="{Binding UnsavedOpen, Converter={StaticResource B2V}}" Background="#66000000">
            <Border Background="White" Padding="16" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="320">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="✕" Command="{Binding CloseUnsavedCommand}" Padding="6,0" AutomationProperties.Name="Back to editing" ToolTip="Back to editing"/>
                        <TextBlock Text="Unsaved changes" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="You have changes that were not saved." TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="שמור וצא" Command="{Binding SaveAndExitCommand}" Padding="12,2"/>
                        <Button Content="צא בלי לשמור" Command="{Binding ExitWithoutSavingCommand}" Padding="12,2" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
