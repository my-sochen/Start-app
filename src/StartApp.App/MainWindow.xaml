<Window x:Class="StartApp.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StartApp.App"
        Title="Start-app" Height="560" Width="900" MinWidth="720" MinHeight="400">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <local:ColorBrushConverter x:Key="ColorBrush"/>
        <local:CardBrushConverter x:Key="CardBrush"/>
        <local:FrameThicknessConverter x:Key="FrameThickness"/>
        <CollectionViewSource x:Key="ItemsView" Source="{Binding Items}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </Window.Resources>
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============ OVERVIEW: workspace cards + create form ============ -->
            <DockPanel Margin="8" Visibility="{Binding InOverview, Converter={StaticResource B2V}}">
                <Button DockPanel.Dock="Top" Content="לכידה ▾" HorizontalAlignment="Left" Padding="12,3" Margin="0,0,0,6" AutomationProperties.Name="Capture"
                        Click="CaptureMenu_Click" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="סביבה חדשה" Command="{Binding PlacementTarget.Tag.CaptureNewCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="סביבה קיימת" Command="{Binding PlacementTarget.Tag.CaptureExistingCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <TextBlock Text="Create workspace" FontWeight="SemiBold"/>
                    <DockPanel Margin="0,4,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="Name" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Workspace name"/>
                    </DockPanel>
                    <DockPanel Margin="0,4,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="Description (optional)" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding NewWorkspaceDescription, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" AutomationProperties.Name="Workspace description"/>
                    </DockPanel>
                    <DockPanel Margin="0,4,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="Category" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding CategoryChoices}" SelectedItem="{Binding NewWorkspaceCategory}" MinWidth="120" HorizontalAlignment="Left" AutomationProperties.Name="Workspace category"/>
                        <TextBlock Text="(כללי is the default)" VerticalAlignment="Center" Foreground="Gray" FontSize="11" Margin="6,0,0,0"/>
                    </DockPanel>
                    <!-- optional card design at creation (spec Nov 12 morning: תיאור, תמונה וצבע יהיו לבחירה); same color rule as עצב כרטיס -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Color (optional)" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding NewWorkspaceColor, UpdateSourceTrigger=PropertyChanged}" Width="90" ToolTip="#RRGGBB" AutomationProperties.Name="Create card color"/>
                        <ItemsControl ItemsSource="{Binding DesignPalette}" Margin="8,0,0,0">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Button Width="22" Height="22" Margin="0,0,4,0" BorderBrush="Gray" BorderThickness="1"
                                        Background="{Binding ., Converter={StaticResource ColorBrush}}"
                                        Command="{Binding DataContext.ApplyCreatePaletteColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                        ToolTip="{Binding}" AutomationProperties.Name="{Binding}"/>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <DockPanel Margin="0,4,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="Image (optional)" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button DockPanel.Dock="Right" Content="הסר תמונה" Command="{Binding RemoveCreateImageCommand}" Padding="8,2" Margin="4,0,0,0" AutomationProperties.Name="Remove create image"/>
                        <Button DockPanel.Dock="Right" Content="העלה תמונה" Command="{Binding PickCreateImageCommand}" Padding="8,2" Margin="4,0,0,0" AutomationProperties.Name="Upload create image"/>
                        <TextBox Text="{Binding NewWorkspaceImagePath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Create card image path" ToolTip="Full path of the uploaded image"/>
                    </DockPanel>
                    <Button Content="Create workspace" Command="{Binding CreateWorkspaceCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="10,2"/>
                </StackPanel>
                <ListBox ItemsSource="{Binding Workspaces}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- card design: without an image the color is the background; with one it is the frame (thick top,
                                 thin other sides, settled Nov 11; exact frame measurements are provisional). The readability
                                 layer behind the text was explicitly left undecided, so there is none. -->
                            <Border Margin="0,2" Padding="4" CornerRadius="4"
                                    BorderBrush="{Binding Color, Converter={StaticResource ColorBrush}}">
                                <Border.BorderThickness>
                                    <Binding Path="ImagePath" Converter="{StaticResource FrameThickness}"/>
                                </Border.BorderThickness>
                                <Border.Background>
                                    <MultiBinding Converter="{StaticResource CardBrush}">
                                        <Binding Path="Color"/>
                                        <Binding Path="ImagePath"/>
                                    </MultiBinding>
                                </Border.Background>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="⋯" Padding="8,2" Margin="4,0,0,0" Background="Transparent"
                                        AutomationProperties.Name="Workspace actions" Click="CardActions_Click" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="הצג" Command="{Binding PlacementTarget.Tag.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                            <MenuItem Header="שגר" Command="{Binding PlacementTarget.Tag.OpenWorkspaceForCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                            <MenuItem Header="הוסף אייטם" Command="{Binding PlacementTarget.Tag.AddItemToCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                            <MenuItem Header="עצב כרטיס" Command="{Binding PlacementTarget.Tag.DesignCardCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                            <MenuItem Header="ערוך קטגוריה" Command="{Binding PlacementTarget.Tag.EditCategoryPopupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <Button DockPanel.Dock="Right" Content="שגר" Padding="8,2" Margin="4,0,0,0" Background="Transparent"
                                        Command="{Binding DataContext.OpenWorkspaceForCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                <Button Command="{Binding DataContext.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                        Background="Transparent" BorderThickness="0"
                                        HorizontalContentAlignment="Left" Padding="6,2" AutomationProperties.Name="{Binding Name}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding EffectiveCategory}" Foreground="Gray" FontSize="11"/>
                                        <TextBlock Foreground="Gray" FontSize="11"><Run Text="Last opened: "/><Run Text="{Binding LastOpenedAt, ConverterCulture=en-US, StringFormat='{}{0:yyyy-MM-dd HH:mm}', TargetNullValue=never, FallbackValue=never}"/></TextBlock>
                                    </StackPanel>
                                </Button>
                            </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- ============ DETAILS: פרטי סביבה ============ -->
            <DockPanel Margin="8" Visibility="{Binding InDetails, Converter={StaticResource B2V}}">
                <DockPanel DockPanel.Dock="Top">
                    <Button DockPanel.Dock="Left" Content="Back" Command="{Binding BackCommand}" Padding="8,2"/>
                    <Button DockPanel.Dock="Right" Content="שגר" Command="{Binding OpenWorkspaceCommand}" Padding="8,2"/>
                    <TextBlock Text="{Binding CreatedAtText, StringFormat='Created: {0}'}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="Gray" Margin="0,0,10,0"/>
                </DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,6,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="Name" Width="80" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Workspace name"/>
                    </DockPanel>
                    <DockPanel Margin="0,4,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="Category" Width="80" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding CategoryChoices}" SelectedItem="{Binding EditCategory}" MinWidth="140" HorizontalAlignment="Left" AutomationProperties.Name="Workspace category"/>
                    </DockPanel>
                    <DockPanel Margin="0,4,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="Description" Width="80" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" AutomationProperties.Name="Workspace description"/>
                    </DockPanel>
                    <Button Content="Save" AutomationProperties.Name="Save workspace details" Command="{Binding SaveDetailsCommand}" HorizontalAlignment="Left" Margin="0,4,0,0" Padding="12,2"
                            Visibility="{Binding DetailsDirty, Converter={StaticResource B2V}}"/>
                </StackPanel>
                <Border DockPanel.Dock="Top" Margin="0,8,0,0" BorderBrush="Gray" BorderThickness="1" Padding="6"
                        Visibility="{Binding ItemEditOpen, Converter={StaticResource B2V}}">
                    <StackPanel>
                        <TextBlock Text="Edit item" FontWeight="SemiBold"/>
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="Name" Width="80" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding EditItemName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Edit item name"/>
                        </DockPanel>
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="Description" Width="80" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding EditItemDescription, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" AutomationProperties.Name="Edit item description"/>
                        </DockPanel>
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="Address" Width="80" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding EditItemTarget, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Edit item target"/>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Save" AutomationProperties.Name="Save item edit" Command="{Binding SaveItemEditCommand}" Padding="12,2" Margin="0,0,6,0"
                                    Visibility="{Binding ItemEditDirty, Converter={StaticResource B2V}}"/>
                            <Button Content="Cancel" Command="{Binding CancelItemEditCommand}" Padding="12,2"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <StackPanel DockPanel.Dock="Top" Margin="0,8,0,0" Visibility="{Binding ShowEmptyItemsMessage, Converter={StaticResource B2V}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="עדיין אין אייטמים בסביבה" VerticalAlignment="Center" FontStyle="Italic"/>
                        <Button Content="הוסף אייטם" Command="{Binding FocusAddCommand}" Padding="10,2" Margin="8,0,0,0"/>
                    </DockPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,8,0,0">
                    <DockPanel>
                        <ComboBox DockPanel.Dock="Left" ItemsSource="{Binding ItemTypes}" SelectedItem="{Binding NewItemType}" Width="90" AutomationProperties.Name="Item type"/>
                        <Button DockPanel.Dock="Right" Content="Add" Command="{Binding AddItemCommand}" Margin="4,0,0,0" Padding="12,2"/>
                        <TextBox x:Name="TargetBox" Text="{Binding NewTarget, UpdateSourceTrigger=PropertyChanged}" MinWidth="120" Margin="4,0,0,0" AutomationProperties.Name="Item target"/>
                    </DockPanel>
                    <DockPanel Margin="0,4,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="Name (optional)" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding NewItemName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Item name"/>
                    </DockPanel>
                    <DockPanel Margin="0,4,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="Description (optional)" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" AutomationProperties.Name="Item description"/>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding DuplicatePending, Converter={StaticResource B2V}}">
                        <TextBlock Text="{Binding DuplicateMessage}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="480"/>
                        <Button Content="Add anyway" Command="{Binding ConfirmDuplicateCommand}" Padding="8,2" Margin="8,0,0,0"/>
                        <Button Content="Cancel" Command="{Binding CancelDuplicateCommand}" Padding="8,2" Margin="4,0,0,0"/>
                    </StackPanel>
                    <Button Content="בחר מסביבות קיימות" Command="{Binding OpenPickerCommand}" HorizontalAlignment="Left" Margin="0,4,0,0" Padding="10,2" AutomationProperties.Name="Pick from existing resources"/>
                    <Button Content="הוסף ממה שפתוח" Command="{Binding AddFromOpenCommand}" HorizontalAlignment="Left" Margin="0,4,0,0" Padding="10,2" AutomationProperties.Name="Add from open items"/>
                </StackPanel>
                <ListView ItemsSource="{Binding Source={StaticResource ItemsView}}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" Margin="0,8,0,0">
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,6,0,2"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Command="{Binding DataContext.OpenItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                        Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" HorizontalAlignment="Left" Cursor="Hand"
                                        ToolTip="Open this item" Padding="0">
                                    <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                </Button>
                                <TextBlock Grid.Column="1" Text="{Binding Type}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Target}" ToolTip="{Binding Target}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal">
                                    <Button Content="עריכה" AutomationProperties.Name="Edit item" Padding="6,0" Margin="0,0,4,0"
                                            Command="{Binding DataContext.EditItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                    <Button Content="⋯" AutomationProperties.Name="Item actions" Click="CardActions_Click" Padding="6,0" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="מחיקה" Command="{Binding PlacementTarget.Tag.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                <MenuItem Header="העתק כתובת" Command="{Binding PlacementTarget.Tag.CopyAddressCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                <MenuItem Header="עריכת כתובת" Command="{Binding PlacementTarget.Tag.EditAddressCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                <MenuItem Header="פתח באמצעות" Command="{Binding PlacementTarget.Tag.OpenWithCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}">
                                                    <MenuItem.Style><Style TargetType="MenuItem"><Style.Triggers>
                                                        <!-- a program item IS the program; open-with does not apply to it -->
                                                        <DataTrigger Binding="{Binding IsProgram}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                    </Style.Triggers></Style></MenuItem.Style>
                                                </MenuItem>
                                                <MenuItem Header="הזז למעלה" Command="{Binding PlacementTarget.Tag.MoveItemUpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                <MenuItem Header="הזז למטה" Command="{Binding PlacementTarget.Tag.MoveItemDownCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                <!-- settled display condition: shown only when another workspace exists; the share popup itself is still undefined (הפרטים טרם הוגדרו), so the entry stays disabled -->
                                                <MenuItem Header="שיתוף לסביבה אחרת" IsEnabled="False" Visibility="Collapsed"/>
                                                <!-- הוסף סקריפט למפתחים: shown only "אם רלוונטי" and that relevance is still undefined (הפרטים טרם הוגדרו), so it is deliberately not in the menu -->
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal">
                                    <!-- the program the item opens with, when one was chosen (התוכנה שבה האייטם נפתח, אם רלוונטי) -->
                                    <TextBlock Foreground="DarkSlateGray" FontSize="11" Margin="0,0,8,2" ToolTip="{Binding Program}">
                                        <Run Text="Opens with: "/><Run Text="{Binding Program}"/>
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers>
                                            <DataTrigger Binding="{Binding Program}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Program}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        </Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Description}" ToolTip="{Binding Description}" Foreground="Gray" FontStyle="Italic" TextTrimming="CharacterEllipsis" Margin="0,0,8,2">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers>
                                            <DataTrigger Binding="{Binding Description}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Description}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        </Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </DockPanel>

            <!-- shared bottom area: preflight panel, report, status -->
            <StackPanel Grid.Row="1" Margin="8,0,8,8">
                <StackPanel Visibility="{Binding ShowOpenPanel, Converter={StaticResource B2V}}" Margin="0,4,0,0">
                    <TextBlock Text="Problems found before opening:" FontWeight="SemiBold" Visibility="{Binding OpenDecisionPending, Converter={StaticResource B2V}}"/>
                    <ListBox ItemsSource="{Binding OpenProblems}" MaxHeight="64" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Visibility="{Binding OpenDecisionPending, Converter={StaticResource B2V}}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="{Binding ConfirmLabel}" Command="{Binding ConfirmOpenAnywayCommand}" Padding="8,2" Visibility="{Binding OpenDecisionPending, Converter={StaticResource B2V}}"/>
                        <Button Content="Cancel" Command="{Binding CancelOpenCommand}" Padding="8,2" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
                <ListBox ItemsSource="{Binding OpenReport}" MaxHeight="64" Margin="0,4,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.Style><Style TargetType="ListBox"><Style.Triggers><DataTrigger Binding="{Binding OpenReport.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ListBox.Style>
                </ListBox>
                <TextBlock Text="{Binding Status}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <!-- ============ capture screen (מסך לכידה): open-now list on one side; new-workspace form, workspace search or the chosen workspace on the other ============ -->
        <Grid Visibility="{Binding CaptureOpen, Converter={StaticResource B2V}}" Background="White">
            <DockPanel Margin="8">
                <DockPanel DockPanel.Dock="Top">
                    <Button DockPanel.Dock="Right" Content="✕" Command="{Binding CaptureCloseCommand}" Padding="8,2" AutomationProperties.Name="Close capture" ToolTip="Close capture"/>
                    <TextBlock Text="לכידה" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
                </DockPanel>
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding CaptureNotes}" Margin="0,2,0,6">
                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="Gray" FontSize="11" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                    <!-- left: depends on the stage -->
                    <Grid Grid.Column="0">
                        <StackPanel Visibility="{Binding IsCaptureNew, Converter={StaticResource B2V}}">
                            <TextBlock Text="סביבה חדשה" FontWeight="SemiBold"/>
                            <DockPanel Margin="0,4,0,0"><TextBlock DockPanel.Dock="Left" Text="Name" Width="80" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Capture workspace name"/></DockPanel>
                            <DockPanel Margin="0,4,0,0"><TextBlock DockPanel.Dock="Left" Text="Description" Width="80" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding NewWorkspaceDescription, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" AutomationProperties.Name="Capture workspace description"/></DockPanel>
                            <DockPanel Margin="0,4,0,0"><TextBlock DockPanel.Dock="Left" Text="Category" Width="80" VerticalAlignment="Center"/>
                                <ComboBox ItemsSource="{Binding CategoryChoices}" SelectedItem="{Binding NewWorkspaceCategory}" MinWidth="120" HorizontalAlignment="Left" AutomationProperties.Name="Capture workspace category"/></DockPanel>
                            <!-- optional card design at creation, same fields as the ordinary create form -->
                            <DockPanel Margin="0,4,0,0"><TextBlock DockPanel.Dock="Left" Text="Color" Width="80" VerticalAlignment="Center"/>
                                <TextBox DockPanel.Dock="Left" Text="{Binding NewWorkspaceColor, UpdateSourceTrigger=PropertyChanged}" Width="90" ToolTip="#RRGGBB" AutomationProperties.Name="Capture card color"/>
                                <ItemsControl ItemsSource="{Binding DesignPalette}" Margin="8,0,0,0" AutomationProperties.Name="Capture palette">
                                    <!-- finite remaining width (DockPanel, not a horizontal StackPanel which measures children with
                                         infinite width) + WrapPanel: at the window minimum the narrow capture column clipped the last
                                         swatch; wrapping inside the bounded space keeps all seven on screen, same order/semantics.
                                         The unique automation name anchors e2e lookups: the overview stays Visible behind this
                                         overlay, so the two palettes' hex-named swatches are ambiguous in the window-wide UIA tree -->
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Button Width="22" Height="22" Margin="0,0,4,0" BorderBrush="Gray" BorderThickness="1"
                                                Background="{Binding ., Converter={StaticResource ColorBrush}}"
                                                Command="{Binding DataContext.ApplyCreatePaletteColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                ToolTip="{Binding}" AutomationProperties.Name="{Binding}"/>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                            <DockPanel Margin="0,4,0,0"><TextBlock DockPanel.Dock="Left" Text="Image" Width="80" VerticalAlignment="Center"/>
                                <Button DockPanel.Dock="Right" Content="הסר תמונה" Command="{Binding RemoveCreateImageCommand}" Padding="8,2" Margin="4,0,0,0" AutomationProperties.Name="Remove capture image"/>
                                <Button DockPanel.Dock="Right" Content="העלה תמונה" Command="{Binding PickCreateImageCommand}" Padding="8,2" Margin="4,0,0,0" AutomationProperties.Name="Upload capture image"/>
                                <TextBox Text="{Binding NewWorkspaceImagePath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Capture card image path" ToolTip="Full path of the uploaded image"/></DockPanel>
                            <TextBlock Text="Only the ticked items on the right are added." Foreground="Gray" FontSize="11" Margin="0,6,0,0"/>
                            <Button Content="Create workspace from capture" Command="{Binding CaptureCreateCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="10,2" AutomationProperties.Name="Create workspace from capture"/>
                        </StackPanel>

                        <DockPanel Visibility="{Binding IsCapturePick, Converter={StaticResource B2V}}">
                            <TextBlock DockPanel.Dock="Top" Text="סביבה קיימת" FontWeight="SemiBold"/>
                            <TextBox DockPanel.Dock="Top" Margin="0,4,0,4" Text="{Binding CaptureSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Capture workspace search"/>
                            <ListBox ItemsSource="{Binding CaptureWorkspaceResults}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.CapturePickWorkspaceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="6,2"
                                                AutomationProperties.Name="{Binding Name, StringFormat='Pick workspace {0}'}">
                                            <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding EffectiveCategory}" Foreground="Gray" FontSize="11"/></StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <DockPanel x:Name="CaptureDropZone" Visibility="{Binding IsCaptureSide, Converter={StaticResource B2V}}" AllowDrop="True" Background="Transparent" Drop="CaptureDropZone_Drop" DragOver="CaptureDropZone_DragOver">
                            <DockPanel DockPanel.Dock="Top">
                                <Button DockPanel.Dock="Left" Content="חזור" Command="{Binding CaptureBackCommand}" Padding="8,1" Margin="0,0,6,0" FontSize="11" AutomationProperties.Name="Capture back"/>
                                <Button DockPanel.Dock="Right" Content="שמור" Command="{Binding CaptureSaveCommand}" Padding="12,2" AutomationProperties.Name="Capture save"/>
                                <TextBlock Text="{Binding CaptureWorkspaceName}" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.AutomationId="CaptureTargetWorkspace" AutomationProperties.Name="{Binding CaptureWorkspaceName}"/>
                            </DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Drag items here or use the add button. Nothing is saved until שמור." Foreground="Gray" FontSize="11" Margin="0,2,0,4"/>
                            <ListBox DockPanel.Dock="Top" MaxHeight="130" ItemsSource="{Binding CaptureWorkspaceItems}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Saved items in the workspace">
                                <ListBox.ItemTemplate>
                                    <DataTemplate><StackPanel><TextBlock><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding Group, Mode=OneWay}" Foreground="Gray"/></TextBlock><TextBlock Text="{Binding Target}" Foreground="Gray" FontSize="11"/></StackPanel></DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock DockPanel.Dock="Top" Text="Added, not saved yet" FontWeight="SemiBold" Margin="0,6,0,2"/>
                            <ListBox ItemsSource="{Binding StagedRows}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Added items not saved yet">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,2">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="✕" Padding="6,0" AutomationProperties.Name="{Binding OriginalName, StringFormat='Remove added {0}'}"
                                                        Command="{Binding DataContext.RemoveStagedCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                <Button DockPanel.Dock="Right" Content="⋯" Padding="6,0" AutomationProperties.Name="Staged item actions" ToolTip="Staged item actions"
                                                        Click="CardActions_Click" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="מחיקה" Command="{Binding PlacementTarget.Tag.RemoveStagedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                            <MenuItem Header="העתק כתובת" Command="{Binding PlacementTarget.Tag.StagedCopyAddressCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                            <MenuItem Header="עריכת כתובת" Command="{Binding PlacementTarget.Tag.StagedEditAddressCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                            <MenuItem Header="פתח באמצעות" Command="{Binding PlacementTarget.Tag.StagedOpenWithCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}">
                                                                <MenuItem.Style><Style TargetType="MenuItem"><Style.Triggers><DataTrigger Binding="{Binding IsProgram}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></MenuItem.Style>
                                                            </MenuItem>
                                                            <MenuItem Header="הזז למעלה" Command="{Binding PlacementTarget.Tag.StagedMoveUpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                            <MenuItem Header="הזז למטה" Command="{Binding PlacementTarget.Tag.StagedMoveDownCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                            <MenuItem Header="שיתוף לסביבה אחרת" IsEnabled="False" Visibility="Collapsed"/>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>
                                                <TextBlock Text="{Binding Group}" Foreground="Gray" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Added item name"/>
                                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" AutomationProperties.Name="Added item description" Margin="0,2,0,0"/>
                                            <TextBox Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Added item address" Margin="0,2,0,0"/>
                                            <TextBox Text="{Binding OpenWith, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Added item open with" Margin="0,2,0,0" ToolTip="Optional: full path to the program/browser to open this item with"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Grid>

                    <!-- right: the capture list (default details only; no actions, no editing) -->
                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Text="Open now" FontWeight="SemiBold"/>
                        <TextBlock DockPanel.Dock="Top" Text="סורק מה פתוח עכשיו..." Foreground="Gray" Margin="0,2,0,2" Visibility="{Binding IsScanning, Converter={StaticResource B2V}}"/>
                        <Button DockPanel.Dock="Top" Content="{Binding CaptureAddLabel}" Command="{Binding CaptureAddCommand}" HorizontalAlignment="Left" Margin="0,4,0,4" Padding="10,2" AutomationProperties.Name="{Binding CaptureAddLabel}"
                                Visibility="{Binding IsCaptureSide, Converter={StaticResource B2V}}"/>
                        <TextBlock DockPanel.Dock="Top" Text="Nothing open was detected" Foreground="Gray" Visibility="{Binding CaptureEmpty, Converter={StaticResource B2V}}"/>
                        <ListBox x:Name="CaptureList" ItemsSource="{Binding CaptureRows}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 PreviewMouseLeftButtonDown="CaptureList_PreviewMouseLeftButtonDown" PreviewMouseMove="CaptureList_PreviewMouseMove" AutomationProperties.Name="Open now list">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding Label}">
                                        <StackPanel><TextBlock><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding Group, Mode=OneWay}" Foreground="Gray"/><Run Text="{Binding BrowserSuffix, Mode=OneWay}" Foreground="Gray"/></TextBlock>
                                            <TextBlock Text="{Binding Target}" Foreground="Gray" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </Grid>

        <!-- duplicate warning for ONE dragged item -->
        <Grid Visibility="{Binding CaptureDupSinglePending, Converter={StaticResource B2V}}" Background="#66000000">
            <Border Background="White" Padding="16" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="320" MaxWidth="480">
                <StackPanel>
                    <TextBlock Text="{Binding CaptureDupSingleMessage}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Add anyway" Command="{Binding ConfirmCaptureDupSingleCommand}" Padding="12,2" AutomationProperties.Name="Capture duplicate add anyway"/>
                        <Button Content="Cancel" Command="{Binding CancelCaptureDupSingleCommand}" Padding="12,2" Margin="8,0,0,0" AutomationProperties.Name="Capture duplicate cancel"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ONE grouped dialog for the duplicates of an add-all / add-selected -->
        <Grid Visibility="{Binding CaptureDupGroupPending, Converter={StaticResource B2V}}" Background="#66000000">
            <Border Background="White" Padding="16" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="340" MaxWidth="520">
                <StackPanel>
                    <TextBlock Text="Already in this workspace" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,6"/>
                    <TextBlock Text="Tick the ones you want to add again as separate instances." TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding CaptureDupChoices}">
                        <ItemsControl.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Label}" AutomationProperties.Name="{Binding Label}" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Add ticked" Command="{Binding ConfirmCaptureDupGroupCommand}" Padding="12,2" AutomationProperties.Name="Capture duplicates add ticked"/>
                        <Button Content="Skip duplicates" Command="{Binding CancelCaptureDupGroupCommand}" Padding="12,2" Margin="8,0,0,0" AutomationProperties.Name="Capture duplicates skip"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ empty-workspace dialog (דיאלוג סביבת עבודה ריקה) ============ -->
        <Grid Visibility="{Binding EmptyWorkspaceOpen, Converter={StaticResource B2V}}" Background="#66000000">
            <Border Background="White" Padding="16" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="300">
                <StackPanel>
                    <TextBlock Text="סביבת עבודה ריקה" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,6"/>
                    <TextBlock Text="This workspace has no items yet." TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="עבור לפרטי הסביבה" Command="{Binding GoToDetailsCommand}" Padding="12,2"/>
                        <Button Content="Close" Command="{Binding CloseEmptyWorkspaceCommand}" Padding="12,2" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ address popup (פופאפ עריכת כתובת) ============ -->
        <Grid Visibility="{Binding AddressEditOpen, Converter={StaticResource B2V}}" Background="#66000000">
            <Border Background="White" Padding="16" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="420">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="✕" Command="{Binding CloseAddressEditCommand}" Padding="6,0" AutomationProperties.Name="Close address edit" ToolTip="Close"/>
                        <TextBlock Text="עריכת כתובת" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBox Text="{Binding EditAddress, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Full address"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="העתק" Command="{Binding CopyFullAddressCommand}" Padding="12,2" AutomationProperties.Name="Copy full address"/>
                        <Button Content="שמור" Command="{Binding SaveAddressCommand}" Padding="12,2" Margin="8,0,0,0"
                                Visibility="{Binding AddressEditDirty, Converter={StaticResource B2V}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ open-with popup (פופאפ פתח באמצעות) ============ -->
        <Grid Visibility="{Binding OpenWithOpen, Converter={StaticResource B2V}}" Background="#66000000">
            <Border Background="White" Padding="16" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="420">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="✕" Command="{Binding CloseOpenWithCommand}" Padding="6,0" AutomationProperties.Name="Close open with" ToolTip="Close"/>
                        <TextBlock Text="פתח באמצעות" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="{Binding OpenWithLabel}" Foreground="Gray" Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <TextBox Text="{Binding OpenWithProgram, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Program path"/>
                    <CheckBox Content="הגדר כברירת מחדל" IsChecked="{Binding OpenWithSetDefault}" Margin="0,6,0,0" AutomationProperties.Name="Set as default"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="פתח" Command="{Binding OpenWithGoCommand}" Padding="12,2" AutomationProperties.Name="Open with chosen program"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ existing-resource picker (בחר מסביבות קיימות): items only, four type buttons,
             original resource names (site address under the name), search, usage-count sort ============ -->
        <Grid Visibility="{Binding PickerOpen, Converter={StaticResource B2V}}" Background="#66000000">
            <Border Background="White" Padding="16" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="460">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="✕" Command="{Binding ClosePickerCommand}" Padding="6,0" AutomationProperties.Name="Close resource picker" ToolTip="Close"/>
                        <TextBlock Text="בחר מסביבות קיימות" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding PickerTypes}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Button Padding="10,2" Margin="0,0,4,0" Command="{Binding DataContext.PickTypeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                    Content="{Binding}" AutomationProperties.Name="Picker type"/>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox Text="{Binding PickerSearch, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" AutomationProperties.Name="Search resources" ToolTip="Search"/>
                    <ListBox ItemsSource="{Binding PickerRows}" MaxHeight="200" Margin="0,6,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Resource list">
                        <ListBox.ItemTemplate><DataTemplate>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="בחר" Padding="8,0" Margin="4,0,0,0" AutomationProperties.Name="Pick resource"
                                        Command="{Binding DataContext.PickResourceCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    <!-- sites also show the address under the name (settled); other types show the name only -->
                                    <TextBlock Text="{Binding Target}" Foreground="Gray" FontSize="11" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
                                            <DataTrigger Binding="{Binding Type}" Value="Link"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                        </Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ card design popup (פופאפ עיצוב כרטיס) ============ -->
        <Grid Visibility="{Binding DesignEditOpen, Converter={StaticResource B2V}}" Background="#66000000">
            <Border Background="White" Padding="16" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="440">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="✕" Command="{Binding CloseDesignCommand}" Padding="6,0" AutomationProperties.Name="Close card design" ToolTip="Close"/>
                        <TextBlock Text="עיצוב כרטיס" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                    </DockPanel>
                    <!-- preview: same color/frame rule as the card, bound to the unsaved values -->
                    <local:PreviewBorder Height="90" CornerRadius="4" Margin="0,0,0,8" BorderBrush="{Binding DesignColor, Converter={StaticResource ColorBrush}}"
                            AutomationProperties.Name="Card design preview">
                        <local:PreviewBorder.BorderThickness>
                            <Binding Path="DesignImagePath" Converter="{StaticResource FrameThickness}"/>
                        </local:PreviewBorder.BorderThickness>
                        <local:PreviewBorder.Background>
                            <MultiBinding Converter="{StaticResource CardBrush}">
                                <Binding Path="DesignColor"/>
                                <Binding Path="DesignImagePath"/>
                            </MultiBinding>
                        </local:PreviewBorder.Background>
                    </local:PreviewBorder>
                    <TextBlock Text="צבע" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBox Text="{Binding DesignColor, UpdateSourceTrigger=PropertyChanged}" Width="90" AutomationProperties.Name="Card color" ToolTip="#RRGGBB"/>
                        <ItemsControl ItemsSource="{Binding DesignPalette}" Margin="8,0,0,0">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Button Width="22" Height="22" Margin="0,0,4,0" BorderBrush="Gray" BorderThickness="1"
                                        Background="{Binding ., Converter={StaticResource ColorBrush}}"
                                        Command="{Binding DataContext.ApplyPaletteColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                        ToolTip="{Binding}"/>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <TextBlock Text="תמונת רקע" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    <DockPanel Margin="0,4,0,0">
                        <Button DockPanel.Dock="Right" Content="הסר תמונה" Command="{Binding RemoveImageCommand}" Padding="8,2" Margin="4,0,0,0" AutomationProperties.Name="Remove card image"/>
                        <Button DockPanel.Dock="Right" Content="העלה תמונה" Command="{Binding PickImageCommand}" Padding="8,2" Margin="4,0,0,0" AutomationProperties.Name="Upload card image"/>
                        <TextBox Text="{Binding DesignImagePath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Card image path" ToolTip="Full path of the uploaded image"/>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="שמור" Command="{Binding SaveDesignCommand}" Padding="12,2"
                                Visibility="{Binding DesignDirty, Converter={StaticResource B2V}}" AutomationProperties.Name="Save card design"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ category popup (פופאפ עריכת קטגוריה) ============ -->
        <Grid Visibility="{Binding CategoryEditOpen, Converter={StaticResource B2V}}" Background="#66000000">
            <Border Background="White" Padding="16" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="440">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="✕" Command="{Binding CloseCategoryPopupCommand}" Padding="6,0" AutomationProperties.Name="Close category popup" ToolTip="Close"/>
                        <TextBlock Text="ערוך קטגוריה" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="{Binding CurrentCategoryName, StringFormat='Current: {0}'}" Foreground="Gray" Margin="0,0,0,4"/>
                    <ListBox ItemsSource="{Binding CategoryRows}" MaxHeight="180" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Category list">
                        <ListBox.ItemTemplate><DataTemplate>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="מחק" Padding="6,0" Margin="4,0,0,0" AutomationProperties.Name="Delete category"
                                        Command="{Binding DataContext.DeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}">
                                    <Button.Style><Style TargetType="Button"><Style.Triggers>
                                        <!-- base categories can never be edited or deleted (settled Nov 11) -->
                                        <DataTrigger Binding="{Binding IsBuiltIn}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    </Style.Triggers></Style></Button.Style>
                                </Button>
                                <Button DockPanel.Dock="Right" Content="ערוך" Padding="6,0" Margin="4,0,0,0" AutomationProperties.Name="Rename category"
                                        Command="{Binding DataContext.BeginRenameCategoryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}">
                                    <Button.Style><Style TargetType="Button"><Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBuiltIn}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    </Style.Triggers></Style></Button.Style>
                                </Button>
                                <Button DockPanel.Dock="Right" Content="בחר" Padding="6,0" Margin="4,0,0,0" AutomationProperties.Name="Pick category"
                                        Command="{Binding DataContext.PickCategoryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <DockPanel Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" Content="הוסף קטגוריה" Command="{Binding AddCategoryCommand}" Padding="8,2" Margin="4,0,0,0" AutomationProperties.Name="Add category"/>
                        <TextBox Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="New category name" ToolTip="Name of a new custom category"/>
                    </DockPanel>
                    <!-- rename a custom category -->
                    <StackPanel Margin="0,8,0,0" Visibility="{Binding RenameCategoryOpen, Converter={StaticResource B2V}}">
                        <TextBlock Text="Rename category" FontWeight="SemiBold"/>
                        <DockPanel Margin="0,4,0,0">
                            <Button DockPanel.Dock="Right" Content="בטל" Command="{Binding CancelRenameCategoryCommand}" Padding="8,2" Margin="4,0,0,0"/>
                            <Button DockPanel.Dock="Right" Content="שמור" Command="{Binding SaveRenameCategoryCommand}" Padding="8,2" Margin="4,0,0,0" AutomationProperties.Name="Save category rename"/>
                            <TextBox Text="{Binding RenameCategoryText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Rename category text"/>
                        </DockPanel>
                    </StackPanel>
                    <!-- deletion warning: one workspace shown directly; several behind a list button (settled Nov 11) -->
                    <Border Margin="0,8,0,0" BorderBrush="DarkOrange" BorderThickness="1" Padding="8"
                            Visibility="{Binding CategoryDeletePending, Converter={StaticResource B2V}}">
                        <StackPanel>
                            <TextBlock Text="{Binding CategoryDeleteMessage}" TextWrapping="Wrap"/>
                            <!-- shown only for several assigned workspaces: with one, the warning shows it directly (the list is already visible) -->
                            <Button Content="הצג רשימה" Command="{Binding ShowCategoryDeleteListCommand}" Padding="8,2" Margin="0,6,0,0" HorizontalAlignment="Left"
                                    AutomationProperties.Name="Show assigned workspaces">
                                <Button.Style><Style TargetType="Button"><Style.Triggers>
                                    <DataTrigger Binding="{Binding CategoryDeleteListShown}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                </Style.Triggers></Style></Button.Style>
                            </Button>
                            <ListBox ItemsSource="{Binding CategoryDeleteWorkspaces}" MaxHeight="90" Margin="0,4,0,0" AutomationProperties.Name="Assigned workspaces"
                                     Visibility="{Binding CategoryDeleteListShown, Converter={StaticResource B2V}}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button Content="מחק והעבר" Command="{Binding ConfirmCategoryDeleteCommand}" Padding="12,2" AutomationProperties.Name="Confirm category delete"/>
                                <Button Content="בטל" Command="{Binding CancelCategoryDeleteCommand}" Padding="12,2" Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ unsaved-changes exit dialog (דיאלוג יציאה עם שינויים שלא נשמרו) ============ -->
        <Grid Visibility="{Binding UnsavedOpen, Converter={StaticResource B2V}}" Background="#66000000">
            <Border Background="White" Padding="16" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="320">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="✕" Command="{Binding CloseUnsavedCommand}" Padding="6,0" AutomationProperties.Name="Back to editing" ToolTip="Back to editing"/>
                        <TextBlock Text="Unsaved changes" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="You have changes that were not saved." TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="שמור וצא" Command="{Binding SaveAndExitCommand}" Padding="12,2"/>
                        <Button Content="צא בלי לשמור" Command="{Binding ExitWithoutSavingCommand}" Padding="12,2" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
