<Window x:Class="StartApp.App.ItemBatchEditWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="עריכת אייטם בסביבות שנבחרו" Width="660" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="Transparent" AllowsTransparency="True" ShowInTaskbar="False" FlowDirection="LeftToRight" FontFamily="./Assets/Fonts/#Noto Sans Hebrew, Arial" Closing="Window_Closing">
 <Window.Resources><Style x:Key="Input" TargetType="TextBox"><Setter Property="FontSize" Value="14"/><Setter Property="BorderBrush" Value="#C5CDDB"/><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,4,0,12"/><Setter Property="TextAlignment" Value="Right"/></Style></Window.Resources>
 <Grid><Border Background="White" BorderBrush="#C9D0DC" BorderThickness="1" CornerRadius="6" Padding="28"><StackPanel>
  <DockPanel><Button DockPanel.Dock="Left" Content="×" Click="Cancel_Click" Background="Transparent" BorderThickness="0" FontSize="16" Foreground="#626B79" AutomationProperties.Name="Close selected item edit"/><TextBlock Text="אייטמים · עריכה" HorizontalAlignment="Right" FontSize="12" Foreground="#636E7D"/></DockPanel>
  <TextBlock Text="עריכת אייטם" HorizontalAlignment="Right" FontSize="24" FontWeight="SemiBold" Foreground="#222833" Margin="0,16,0,10"/>
  <TextBlock x:Name="Scope" FontSize="13" Foreground="#626B79" TextAlignment="Right" TextWrapping="Wrap"/>
  <TextBlock Text="רק שדות ששונו יוחלו על הסביבות שנבחרו. הגדרות הפתיחה לא משתנות." FontSize="12" Foreground="#667388" TextAlignment="Right" Margin="0,6,0,18"/>
  <TextBlock x:Name="NameLabel" Text="שם" HorizontalAlignment="Right"/><TextBox x:Name="NameInput" Style="{StaticResource Input}" TextChanged="Input_Changed" AutomationProperties.Name="Selected item name"/>
  <TextBlock x:Name="DescriptionLabel" Text="תיאור" HorizontalAlignment="Right"/><TextBox x:Name="DescriptionInput" Style="{StaticResource Input}" TextChanged="Input_Changed" MaxLength="500" AutomationProperties.Name="Selected item description"/>
  <CheckBox x:Name="ClearDescription" Content="נקה את התיאור בסביבות שנבחרו" HorizontalAlignment="Right" Checked="ClearDescription_Changed" Unchecked="ClearDescription_Changed" Margin="0,0,0,14"/>
  <TextBlock Text="כתובת" HorizontalAlignment="Right"/><TextBox x:Name="TargetInput" Style="{StaticResource Input}" TextAlignment="Left" TextChanged="Input_Changed" FlowDirection="LeftToRight" AutomationProperties.Name="Selected item target"/>
  <TextBlock x:Name="Error" Foreground="#9B3030" TextAlignment="Right" TextWrapping="Wrap" Margin="0,0,0,8"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="ביטול" Click="Cancel_Click" Style="{StaticResource HomeToolbarButton}" Height="38" Padding="16,7" Margin="0,0,8,0" AutomationProperties.Name="Cancel selected item edit"/><Button x:Name="SaveButton" Content="שמור" Click="Save_Click" Style="{StaticResource PrimaryActionButton}" Height="38" IsEnabled="False" AutomationProperties.Name="Save selected item edit"/></StackPanel>
 </StackPanel></Border>
 <Grid x:Name="UnsavedShade" Visibility="Collapsed" Background="#66505A70"><Border Background="White" CornerRadius="6" BorderBrush="#C9D0DC" BorderThickness="1" Padding="24" Margin="20" VerticalAlignment="Center"><StackPanel><TextBlock Text="יש שינויים שלא נשמרו" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Right"/><TextBlock Text="לשמור את השינויים לפני היציאה מהעריכה?" TextAlignment="Right" Margin="0,14,0,22"/><WrapPanel HorizontalAlignment="Right"><Button Content="חזרה לעריכה" Click="KeepEditing_Click" Style="{StaticResource HomeToolbarButton}" Padding="12,7" Margin="0,0,8,0"/><Button Content="צא בלי לשמור" Click="Discard_Click" Style="{StaticResource HomeToolbarButton}" Padding="12,7" Margin="0,0,8,0"/><Button Content="שמור וצא" Click="Save_Click" Style="{StaticResource PrimaryActionButton}"/></WrapPanel></StackPanel></Border></Grid>
 </Grid>
</Window>
