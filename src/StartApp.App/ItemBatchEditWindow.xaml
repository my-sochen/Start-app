<Window x:Class="StartApp.App.ItemBatchEditWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:StartApp.App"
 Title="עריכת אייטם בסביבות שנבחרו" Width="560" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="Transparent" AllowsTransparency="True" ShowInTaskbar="False" FlowDirection="LeftToRight" FontFamily="./Assets/Fonts/#Noto Sans Hebrew, Arial" Closing="Window_Closing">
 <Grid><Border Background="White" BorderBrush="#C9D0DC" BorderThickness="1" CornerRadius="6" Padding="28"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
  <DockPanel><Button DockPanel.Dock="Left" Content="×" Click="Cancel_Click" Background="Transparent" BorderThickness="0" FontSize="16" Foreground="#626B79" AutomationProperties.Name="Close selected item edit"/><TextBlock x:Name="CaptionLabel" Text="אייטמים · עריכה" HorizontalAlignment="Right" FontSize="12" Foreground="#636E7D"/></DockPanel>
  <TextBlock x:Name="TitleLabel" Text="עריכת אייטם" HorizontalAlignment="Right" FontSize="24" FontWeight="SemiBold" Foreground="#222833" Margin="0,16,0,10"/>
  <TextBlock x:Name="Scope" FontSize="13" Foreground="#626B79" FlowDirection="RightToLeft" TextAlignment="Left" TextWrapping="Wrap" LineHeight="24" Margin="0,0,0,18"/>
  <Border Background="#F4F6FD" BorderBrush="#C8D5F5" BorderThickness="0,1,0,0" Padding="10">
   <StackPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel x:Name="NameField" Grid.Column="2"><TextBlock x:Name="NameLabel" FlowDirection="RightToLeft" TextAlignment="Left" Text="שם האייטם" HorizontalAlignment="Right" FontSize="12" Foreground="#667388"/><TextBox x:Name="NameInput" Style="{StaticResource CompactItemInput}" TextChanged="Input_Changed" AutomationProperties.Name="Selected item name"/></StackPanel>
     <StackPanel x:Name="OpenWithField" Grid.Column="0"><TextBlock x:Name="OpenWithLabel" Text="פתח באמצעות" HorizontalAlignment="Right" FontSize="12" Foreground="#667388"/><ComboBox Style="{StaticResource OpenWithDropdown}" x:Name="OpenWithInput" FlowDirection="RightToLeft" local:OpenWithPicker.Path="" Height="34" Margin="0,4,0,10" Background="White" BorderBrush="#C5CDDB" Padding="8,4" SelectionChanged="Launch_Changed" AutomationProperties.Name="Selected item open with"/></StackPanel>
    </Grid>
    <CheckBox x:Name="ClearLaunch" Content="ברירת המחדל של Windows בכל הסביבות שנבחרו" HorizontalAlignment="Right" Checked="ClearLaunch_Changed" Unchecked="ClearLaunch_Changed" Margin="0,0,0,10" FontSize="12"/>
    <TextBlock x:Name="DescriptionLabel" FlowDirection="RightToLeft" TextAlignment="Left" Text="תיאור" HorizontalAlignment="Right" FontSize="12" Foreground="#667388"/><TextBox x:Name="DescriptionInput" Style="{StaticResource CompactItemInput}" TextChanged="Input_Changed" MaxLength="500" AutomationProperties.Name="Selected item description"/>
    <CheckBox x:Name="ClearDescription" Content="נקה את התיאור בכל הסביבות שנבחרו" HorizontalAlignment="Right" Checked="ClearDescription_Changed" Unchecked="ClearDescription_Changed" Margin="0,0,0,10" FontSize="12"/>
    <TextBlock x:Name="TargetLabel" Text="נתיב" HorizontalAlignment="Right" FontSize="12" Foreground="#667388"/><TextBox x:Name="TargetInput" Style="{StaticResource CompactItemInput}" Margin="0,4,0,0" TextAlignment="Left" TextChanged="Input_Changed" FlowDirection="LeftToRight" AutomationProperties.Name="Selected item target"/>
   </StackPanel>
  </Border>
  <TextBlock x:Name="Error" Foreground="#9B3030" FlowDirection="RightToLeft" TextAlignment="Left" TextWrapping="Wrap" Margin="0,8,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
  <Border BorderBrush="#E0E6F0" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,20,0,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="ביטול" Click="Cancel_Click" Style="{StaticResource DialogSecondaryButton}" Margin="0,0,8,0" AutomationProperties.Name="Cancel selected item edit"/><Button x:Name="SaveButton" Content="שמור" Click="Save_Click" Style="{StaticResource DialogPrimaryButton}" IsEnabled="False" AutomationProperties.Name="Save selected item edit"/></StackPanel></Border>
 </StackPanel></ScrollViewer></Border>
 <Grid x:Name="UnsavedShade" KeyboardNavigation.TabNavigation="Cycle" Visibility="Collapsed" Background="#66505A70"><Border Background="White" CornerRadius="6" BorderBrush="#C9D0DC" BorderThickness="1" Padding="24" Margin="20" VerticalAlignment="Center"><StackPanel><DockPanel><Button x:Name="KeepEditingButton" DockPanel.Dock="Left" Content="×" Click="KeepEditing_Click" AutomationProperties.Name="Keep selected item editing" ToolTip="חזרה לעריכה" FocusVisualStyle="{StaticResource SolidDialogFocus}" Style="{StaticResource QuietTextButton}" Width="20" Height="20" FontSize="16"/><TextBlock Text="יש שינויים שלא נשמרו" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Right"/></DockPanel><TextBlock Text="לשמור את השינויים לפני היציאה מהעריכה?" FlowDirection="RightToLeft" TextAlignment="Left" Margin="0,14,0,22"/><WrapPanel HorizontalAlignment="Right"><Button Content="צא בלי לשמור" Click="Discard_Click" Style="{StaticResource HomeToolbarButton}" Padding="12,7" Margin="0,0,8,0"/><Button Content="שמור וצא" Click="Save_Click" Style="{StaticResource PrimaryActionButton}"/></WrapPanel></StackPanel></Border></Grid>
 </Grid>
</Window>
