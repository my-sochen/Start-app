<Window x:Class="StartApp.App.UpdateAvailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StartApp.App"
        Title="עדכון חדש זמין" Width="560" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" Background="Transparent" AllowsTransparency="True" ShowInTaskbar="False" FontFamily="./Assets/Fonts/#Noto Sans Hebrew, Arial"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" KeyDown="Window_KeyDown"
        AutomationProperties.Name="Startup update available">
    <local:DialogFrame Padding="28" Background="White" BorderBrush="#C9D0DC" BorderThickness="1" CornerRadius="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"><Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,20"><Button Content="×" DockPanel.Dock="Right" Click="Close_Click" Style="{StaticResource QuietTextButton}" Width="24" Height="24" AutomationProperties.Name="Close update notice"/><TextBlock Text="עדכון חדש זמין" FontSize="24" FontWeight="SemiBold" Foreground="#222833"/></DockPanel>
        <StackPanel Grid.Row="1">
            <local:VersionDisplayText DisplayText="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <TextBlock Text="אפשר לעדכן עכשיו או לסגור ולהמשיך לעבוד. ההתקנה ידנית לאחר ההורדה."
                       TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,24,0,0">
            <Button Content="עדכון - פתח הורדה רשמית" Command="{Binding DownloadCommand}" Style="{StaticResource DialogPrimaryButton}"
                    AutomationProperties.Name="Update via official download"/>
            <Button Content="לא עכשיו" Click="Close_Click" Style="{StaticResource DialogSecondaryButton}" Margin="8,0,0,0"
                    AutomationProperties.Name="Dismiss update and continue"/>
        </StackPanel>
    </Grid></local:DialogFrame>
</Window>
