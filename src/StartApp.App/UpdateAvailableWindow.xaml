<Window x:Class="StartApp.App.UpdateAvailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="עדכון חדש זמין" Width="560" Height="300" MinWidth="460" MinHeight="260"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" KeyDown="Window_KeyDown"
        AutomationProperties.Name="Startup update available">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="עדכון חדש זמין" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/>
        <StackPanel Grid.Row="1">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <TextBlock Text="אפשר לעדכן עכשיו או לסגור ולהמשיך לעבוד. ההתקנה ידנית לאחר ההורדה."
                       TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
            <Button Content="עדכון - פתח הורדה רשמית" Command="{Binding DownloadCommand}" Padding="12,8"
                    AutomationProperties.Name="Update via official download"/>
            <Button Content="לא עכשיו" Click="Close_Click" Padding="12,8" Margin="12,0,0,0"
                    AutomationProperties.Name="Dismiss update and continue"/>
        </StackPanel>
    </Grid>
</Window>
