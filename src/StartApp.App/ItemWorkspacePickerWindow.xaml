<Window x:Class="StartApp.App.ItemWorkspacePickerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="בחירת סביבות לפעולה" Width="520" SizeToContent="Height" ResizeMode="NoResize" WindowStyle="None" WindowStartupLocation="CenterOwner"
 FlowDirection="LeftToRight" FontFamily="./Assets/Fonts/#Noto Sans Hebrew, Arial" ShowInTaskbar="False" Background="Transparent" AllowsTransparency="True">
 <Border Background="White" CornerRadius="6" Padding="28" BorderBrush="#C9D0DC" BorderThickness="1">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,16"><Button DockPanel.Dock="Left" Content="×" Click="Cancel_Click" Background="Transparent" BorderThickness="0" Foreground="#626B79" FontSize="16" Cursor="Hand" AutomationProperties.Name="Close item workspace picker"/><TextBlock x:Name="Breadcrumb" Text="אייטמים · בחירת סביבות" HorizontalAlignment="Right" FontSize="12" Foreground="#636E7D"/></DockPanel>
   <TextBlock Grid.Row="1" x:Name="Heading" FlowDirection="RightToLeft" FontSize="24" FontWeight="SemiBold" Foreground="#222833" HorizontalAlignment="Right"/>
   <TextBlock Grid.Row="2" x:Name="Explanation" FlowDirection="RightToLeft" TextAlignment="Left" TextWrapping="Wrap" FontSize="13" LineHeight="24" Foreground="#626B79" Margin="0,14,0,18"/>
   <ListBox Grid.Row="3" x:Name="Rows" SelectionMode="Multiple" SelectionChanged="Rows_SelectionChanged" BorderThickness="0" Padding="0" Background="Transparent" MaxHeight="330" ScrollViewer.VerticalScrollBarVisibility="Auto" FlowDirection="RightToLeft" AutomationProperties.Name="Choose item environments">
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="AutomationProperties.Name" Value="{Binding Name}"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
     <Border x:Name="Surface" Background="Transparent" BorderBrush="#E6EAF1" BorderThickness="0,0,0,1" Padding="0,16" FlowDirection="LeftToRight">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions><ContentPresenter Margin="0,0,10,0"/><Border x:Name="CheckBox" Grid.Column="1" Width="18" Height="18" CornerRadius="3" BorderBrush="#C5CAD4" BorderThickness="1" Background="White" VerticalAlignment="Center"><TextBlock x:Name="Check" Text="✓" FontSize="12" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/></Border></Grid>
     </Border>
     <ControlTemplate.Triggers><DataTrigger Binding="{Binding IsLast}" Value="True"><Setter TargetName="Surface" Property="BorderThickness" Value="0"/></DataTrigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#F5F8FF"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="CheckBox" Property="Background" Value="#315CC5"/><Setter TargetName="CheckBox" Property="BorderBrush" Value="#315CC5"/><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate><DataTemplate><StackPanel HorizontalAlignment="Right"><StackPanel Orientation="Horizontal" FlowDirection="RightToLeft"><Ellipse Width="11" Height="11" Fill="{Binding Color}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="#222833"/></StackPanel><TextBlock Text="{Binding DisplayCategory}" HorizontalAlignment="Right" FontSize="12" Foreground="#667388" Margin="0,2,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <StackPanel Grid.Row="4"><TextBlock x:Name="SelectionSummary" FlowDirection="RightToLeft" Text="לא נבחרו סביבות" HorizontalAlignment="Right" FontSize="12" Foreground="#667388" Margin="0,14,0,0"/><Border BorderBrush="#E6EAF1" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,20,0,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="ביטול" Click="Cancel_Click" Style="{StaticResource HomeToolbarButton}" Height="38" Padding="16,7" Margin="0,0,8,0" AutomationProperties.Name="Cancel item workspace choice"/><Button x:Name="ConfirmButton" Content="המשך לעריכה" IsEnabled="False" Click="Confirm_Click" Style="{StaticResource PrimaryActionButton}" Height="38" Padding="16,7" AutomationProperties.Name="Confirm item workspace choice"/></StackPanel></Border></StackPanel>
  </Grid>
 </Border>
</Window>
