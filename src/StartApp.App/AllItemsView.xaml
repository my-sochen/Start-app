<UserControl x:Class="StartApp.App.AllItemsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:StartApp.App" xmlns:sys="clr-namespace:System;assembly=System.Runtime"
 Background="#F7F8FB" FlowDirection="LeftToRight" FontFamily="./Assets/Fonts/#Noto Sans Hebrew, Arial" AutomationProperties.Name="All items screen">
 <UserControl.Resources>
  <local:DetailsGroupConverter x:Key="GroupLabel"/><local:FirstLetterConverter x:Key="FirstLetter"/>
  <CollectionViewSource x:Key="AllItemsSource" Source="{Binding AllItemRows}"><CollectionViewSource.GroupDescriptions><PropertyGroupDescription PropertyName="Group"><PropertyGroupDescription.CustomSort><local:DetailsGroupComparer/></PropertyGroupDescription.CustomSort></PropertyGroupDescription></CollectionViewSource.GroupDescriptions></CollectionViewSource>
  <Style x:Key="WorkspaceTag" TargetType="Button">
   <Setter Property="Background" Value="#F4F6F9"/><Setter Property="Foreground" Value="#6B778A"/><Setter Property="FontSize" Value="11"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="#D9E0EB" BorderThickness="1" CornerRadius="3" Padding="7,3" Margin="4,2,0,2"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#EAF0FA"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <UserControl.InputBindings><KeyBinding Key="Escape" Command="{Binding CloseAllItemsCommand}"/></UserControl.InputBindings>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Margin="32,22,32,0">
   <TextBlock Text="אופציות   /   רשימת אייטמים כללית" FlowDirection="RightToLeft" FontSize="12" Foreground="#636E7D" Margin="0,0,0,17"/>
   <Grid>
    <Button Content="→" Foreground="#315CC5" FontFamily="Segoe UI Symbol" FontSize="24" ToolTip="חזרה לסביבות" Command="{Binding CloseAllItemsCommand}" Style="{StaticResource QuietTextButton}" Width="38" Height="38" VerticalAlignment="Top" HorizontalAlignment="Left" AutomationProperties.Name="Back to workspaces"/>
    <StackPanel HorizontalAlignment="Right" FlowDirection="RightToLeft"><TextBlock Text="רשימת אייטמים כללית" FontSize="22" FontWeight="SemiBold" Foreground="#222833"/><TextBlock Text="כל האייטמים מכל הסביבות במקום אחד. התגיות מראות באילו סביבות כל אייטם נמצא. לחיצה על שם האייטם משגרת אותו, קליק ימני פותח את הפעולות." FontSize="13" Foreground="#626B79" Margin="0,2,0,0"/></StackPanel>
   </Grid>
   <Grid Height="42" Margin="0,16,0,24">
    <TextBlock Text="{Binding AllItemsCountText}" FlowDirection="RightToLeft" TextAlignment="Left" FontSize="12" FontWeight="SemiBold" Foreground="#586A8D" VerticalAlignment="Center"/>
    <Border HorizontalAlignment="Right" Width="340" Background="White" BorderBrush="#C5CDDB" BorderThickness="1" CornerRadius="4"><Grid><TextBlock Text="⌕" FontFamily="Arial" FontSize="15" Foreground="#63728B" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/><TextBox Text="{Binding AllItemsSearch, UpdateSourceTrigger=PropertyChanged}" FlowDirection="RightToLeft" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" FontSize="15" Margin="0,0,36,0" Padding="12,8" AutomationProperties.Name="Search all items"/><TextBlock Text="חיפוש בכל האייטמים" FlowDirection="RightToLeft" FontSize="15" Foreground="#788395" Margin="12,0,38,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding AllItemsSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Border>
   </Grid>
  </StackPanel>
  <ScrollViewer Grid.Row="1" Margin="32,0,32,22" FlowDirection="RightToLeft" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" AutomationProperties.Name="All items viewport">
   <ScrollViewer.Resources><sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarWidthKey}">8</sys:Double></ScrollViewer.Resources>
   <ListView ItemsSource="{Binding Source={StaticResource AllItemsSource}}" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListView.ItemContainerStyle>
    <ListView.GroupStyle><GroupStyle>
     <GroupStyle.ContainerStyle><Style TargetType="GroupItem"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupItem"><Border Background="White" BorderBrush="#DCE1E9" BorderThickness="1" CornerRadius="4" Margin="0,0,0,8"><DockPanel><ContentPresenter DockPanel.Dock="Top" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/><ItemsPresenter/></DockPanel></Border></ControlTemplate></Setter.Value></Setter></Style></GroupStyle.ContainerStyle>
     <GroupStyle.HeaderTemplate><DataTemplate><Border Background="#F0F3F8" BorderBrush="#DCE1E9" BorderThickness="0,0,0,1" Padding="14,6"><TextBlock FontSize="12" Foreground="#414856"><Run Text="{Binding Name, Mode=OneWay, Converter={StaticResource GroupLabel}}"/><Run Text=" · "/><Run Text="{Binding ItemCount, Mode=OneWay}"/></TextBlock></Border></DataTemplate></GroupStyle.HeaderTemplate>
    </GroupStyle></ListView.GroupStyle>
    <ListView.ItemTemplate><DataTemplate>
     <Border BorderBrush="#EEF1F6" BorderThickness="0,0,0,1" Padding="14,5" MinHeight="49" FlowDirection="LeftToRight" ContextMenuOpening="ItemContextOpening">
      <Border.ContextMenu><ContextMenu><MenuItem Header="פעולות"/></ContextMenu></Border.ContextMenu>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="350"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
       <TextBlock Text="{Binding Target}" ToolTip="{Binding Target}" TextTrimming="CharacterEllipsis" Foreground="#667388" FontFamily="Arial" FontSize="12" FlowDirection="LeftToRight" VerticalAlignment="Center"/>
       <ItemsControl Grid.Column="1" ItemsSource="{Binding Workspaces}" HorizontalAlignment="Right" Margin="8,0,12,0" VerticalAlignment="Center"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel FlowDirection="RightToLeft"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="#F4F6F9" BorderBrush="#D9E0EB" BorderThickness="1" CornerRadius="3" Padding="7,3" Margin="4,2,0,2"><TextBlock Text="{Binding Name}" FontSize="11" Foreground="#6B778A"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       <Button Grid.Column="2" Cursor="Hand" Command="{Binding DataContext.OpenAllItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Name}"><Button.Template><ControlTemplate TargetType="Button"><ContentPresenter/></ControlTemplate></Button.Template><StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" HorizontalAlignment="Right"><Border Width="30" Height="30" Background="#EEF2F9" BorderBrush="#D9E0EF" BorderThickness="1" CornerRadius="6" Margin="0,0,12,0"><TextBlock Text="{Binding Name, Converter={StaticResource FirstLetter}}" Foreground="#4766A5" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" MaxWidth="230" TextTrimming="CharacterEllipsis" FontSize="13" FontWeight="SemiBold" Foreground="#315CC5" TextDecorations="Underline"/><TextBlock Text="{Binding TypeLabel}" FontSize="11" Foreground="#667388"/></StackPanel></StackPanel></Button>
      </Grid>
     </Border>
    </DataTemplate></ListView.ItemTemplate>
   </ListView>
  </ScrollViewer>
 </Grid>
</UserControl>
