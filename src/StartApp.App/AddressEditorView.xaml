<local:DialogFrame x:Class="StartApp.App.AddressEditorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:StartApp.App" xmlns:sys="clr-namespace:System;assembly=System.Runtime" MinWidth="420">
    <local:DialogFrame.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
    </local:DialogFrame.Resources>
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="✕" Command="{Binding CloseAddressEditCommand}" Style="{StaticResource CompactIconButton}" AutomationProperties.Name="Close address edit" ToolTip="Close"/>
                        <TextBlock Text="עריכת כתובת" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBox Text="{Binding EditAddress, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Full address"/>
                    <TextBlock Text="{Binding AddressError}" Foreground="#9B3030" TextWrapping="Wrap" FlowDirection="RightToLeft"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="העתק" Command="{Binding CopyFullAddressCommand}" Style="{StaticResource CompactActionButton}" AutomationProperties.Name="Copy full address"/>
                        <Button Content="שמור" Command="{Binding SaveAddressCommand}" Style="{StaticResource CompactActionButton}" Margin="8,0,0,0"
                                Visibility="{Binding AddressEditDirty, Converter={StaticResource B2V}}"/>
                    </StackPanel>
                </StackPanel>
            </local:DialogFrame>
