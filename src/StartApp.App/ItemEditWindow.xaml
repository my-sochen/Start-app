<Window x:Class="StartApp.App.ItemEditWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:StartApp.App"
 Title="עריכת אייטם" Width="560" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="Transparent" AllowsTransparency="True" ShowInTaskbar="False" FlowDirection="LeftToRight" FontFamily="./Assets/Fonts/#Noto Sans Hebrew, Arial" Closing="Window_Closing">
 <Window.Resources><BooleanToVisibilityConverter x:Key="B2V"/><Style x:Key="Input" TargetType="TextBox" BasedOn="{StaticResource DetailsInput}"><Setter Property="Height" Value="34"/><Setter Property="MinHeight" Value="34"/><Setter Property="FontSize" Value="14"/><Setter Property="BorderBrush" Value="#C5CDDB"/><Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="0,4,0,10"/><Setter Property="TextAlignment" Value="Right"/></Style></Window.Resources>
 <Grid><Border Background="White" BorderBrush="#C9D0DC" BorderThickness="1" CornerRadius="6" Padding="28"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
  <DockPanel><Button DockPanel.Dock="Left" Content="×" Click="Cancel_Click" Background="Transparent" BorderThickness="0" FontSize="16" Foreground="#626B79" AutomationProperties.Name="Close item edit"/><TextBlock x:Name="CaptionLabel" HorizontalAlignment="Right" FontSize="12" Foreground="#636E7D"/></DockPanel>
  <TextBlock x:Name="TitleLabel" HorizontalAlignment="Right" FontSize="24" FontWeight="SemiBold" Foreground="#222833" Margin="0,16,0,10"/>
  <Border Background="#F4F6FD" BorderBrush="#C8D5F5" BorderThickness="0,1,0,0" Padding="10">
   <StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Grid.Column" Value="2"/><Style.Triggers><DataTrigger Binding="{Binding EditItemOpenWithApplicable}" Value="False"><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="3"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="שם האייטם" HorizontalAlignment="Right" FontSize="12" Foreground="#667388"/><TextBox x:Name="NameInput" Text="{Binding EditItemName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" AutomationProperties.Name="Edit item name"/></StackPanel>
    <StackPanel Grid.Column="0" Visibility="{Binding EditItemOpenWithApplicable, Converter={StaticResource B2V}}"><TextBlock Text="פתח באמצעות" HorizontalAlignment="Right" FontSize="12" Foreground="#667388"/><ComboBox x:Name="OpenWithInput" Style="{StaticResource OpenWithDropdown}" FlowDirection="RightToLeft" local:OpenWithPicker.WebsiteTarget="{Binding EditItemTarget}" local:OpenWithPicker.DefaultLabel="{Binding EditItemOpenWithDefaultLabel}" local:OpenWithPicker.Path="{Binding EditItemOpenWith, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="34" Margin="0,4,0,10" Background="White" BorderBrush="#C5CDDB" Padding="8,4" IsEnabled="{Binding EditItemOpenWithApplicable}" AutomationProperties.Name="Edit item open with"/></StackPanel>
   </Grid>
   <TextBlock Text="תיאור" HorizontalAlignment="Right" FontSize="12" Foreground="#667388"/><TextBox Text="{Binding EditItemDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" MaxLength="500" AutomationProperties.Name="Edit item description"/>
   <TextBlock Text="{Binding EditItemTargetLabel}" HorizontalAlignment="Right" FontSize="12" Foreground="#667388"/><TextBox Text="{Binding EditItemTarget, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Margin="0,4,0,0" TextAlignment="Left" FlowDirection="LeftToRight" AutomationProperties.Name="Edit item target"/>
   </StackPanel>
  </Border>
  <TextBlock Text="{Binding ItemEditError}" Foreground="#9B3030" FlowDirection="RightToLeft" TextAlignment="Left" TextWrapping="Wrap" Margin="0,8,0,0"/>
  <Border BorderBrush="#E0E6F0" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,20,0,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="ביטול" Click="Cancel_Click" Style="{StaticResource DialogSecondaryButton}" Margin="0,0,8,0" AutomationProperties.Name="Cancel item edit"/><Button Content="שמור" Click="Save_Click" Style="{StaticResource DialogPrimaryButton}" IsEnabled="{Binding ItemEditDirty}" IsDefault="True" AutomationProperties.Name="Save item edit"/></StackPanel></Border>
 </StackPanel></ScrollViewer></Border>
 <Grid x:Name="UnsavedShade" KeyboardNavigation.TabNavigation="Cycle" Visibility="Collapsed" Background="#66505A70"><Border Background="White" CornerRadius="6" BorderBrush="#C9D0DC" BorderThickness="1" Padding="24" Margin="20" VerticalAlignment="Center"><StackPanel><DockPanel><Button x:Name="KeepEditingButton" DockPanel.Dock="Left" Content="×" Click="KeepEditing_Click" AutomationProperties.Name="Keep item editing" ToolTip="חזרה לעריכה" FocusVisualStyle="{StaticResource SolidDialogFocus}" Style="{StaticResource QuietTextButton}" Width="20" Height="20" FontSize="16"/><TextBlock Text="יש שינויים שלא נשמרו" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Right"/></DockPanel><TextBlock Text="לשמור את השינויים לפני היציאה מהעריכה?" FlowDirection="RightToLeft" TextAlignment="Left" Margin="0,14,0,22"/><WrapPanel HorizontalAlignment="Right"><Button Content="צא בלי לשמור" Click="Discard_Click" Style="{StaticResource HomeToolbarButton}" Padding="12,7" Margin="0,0,8,0"/><Button Content="שמור וצא" Click="Save_Click" Style="{StaticResource PrimaryActionButton}"/></WrapPanel></StackPanel></Border></Grid>
 </Grid>
</Window>
