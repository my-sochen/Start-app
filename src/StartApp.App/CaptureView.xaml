<UserControl x:Class="StartApp.App.CaptureView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:StartApp.App" Focusable="False">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="B2V"/>
  <local:ColorBrushConverter x:Key="ColorBrush"/>
 </UserControl.Resources>
        <Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:StartApp.App" Visibility="{Binding CaptureOpen, Converter={StaticResource B2V}}" Background="#F7F8FB">
 <Grid Margin="32,24,32,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <TextBlock Text="סביבות העבודה  /  לכידה לסביבה" FontSize="12" Foreground="#667388" HorizontalAlignment="Right" Margin="0,0,0,20"/>
  <Grid Grid.Row="1" Margin="0,0,0,20"><Button Content="סגירת הלכידה ×" Command="{Binding CaptureCloseCommand}" Style="{StaticResource DialogSecondaryButton}" HorizontalAlignment="Left" VerticalAlignment="Top" AutomationProperties.Name="Close capture"/>
   <StackPanel HorizontalAlignment="Right"><TextBlock Text="הוסף ממה שפתוח" FontSize="24" FontWeight="SemiBold" Foreground="#222833" HorizontalAlignment="Right"/><TextBlock Text="בחר פריטים שנמצאו במחשב והוסף אותם לסביבה שבחרת." FlowDirection="RightToLeft" TextAlignment="Left" FontSize="13" Foreground="#667388" Margin="0,4,0,0"/></StackPanel>
  </Grid>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Background="White" BorderBrush="#CFD7E6" BorderThickness="1" CornerRadius="4"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#EDF1F7" BorderBrush="#CFD7E6" BorderThickness="0,0,0,1" Padding="16,14"><Grid><Button Content="חזרה לבחירת סביבה" Command="{Binding CaptureBackCommand}" Visibility="{Binding IsCaptureSide, Converter={StaticResource B2V}}" Style="{StaticResource QuietTextButton}" Foreground="#315CC5" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Top" AutomationProperties.Name="Capture back"/><StackPanel HorizontalAlignment="Right"><TextBlock Text="{Binding CaptureTargetHeader}" FontSize="16" FontWeight="SemiBold" Foreground="#222833" HorizontalAlignment="Right" AutomationProperties.AutomationId="CaptureTargetWorkspace" AutomationProperties.Name="{Binding CaptureWorkspaceName}"/><TextBlock Text="הפריטים שהוספת יישמרו רק בלחיצה על שמור." FlowDirection="RightToLeft" TextAlignment="Left" FontSize="12" Foreground="#667388" Margin="0,6,0,0"/></StackPanel></Grid></Border>
    <Grid Grid.Row="1" Margin="24,16"><ScrollViewer Visibility="{Binding IsCaptureNew, Converter={StaticResource B2V}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="New capture workspace form"><StackPanel>
 <StackPanel FlowDirection="RightToLeft">
  <TextBlock Text="סביבה חדשה" FontSize="18" FontWeight="SemiBold" Foreground="#222833" Margin="0,0,0,16"/>
  <TextBlock Text="שם הסביבה" FontSize="12" Foreground="#667388"/>
  <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DetailsInput}" Margin="0,4,0,12" AutomationProperties.Name="Capture workspace name"/>
  <TextBlock Text="תיאור" FontSize="12" Foreground="#667388"/>
  <TextBox Text="{Binding NewWorkspaceDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DetailsInput}" MaxLength="500" Margin="0,4,0,12" AutomationProperties.Name="Capture workspace description"/>
  <TextBlock Text="קטגוריה" FontSize="12" Foreground="#667388"/>
  <local:CategoryPicker SelectedCategory="{Binding NewWorkspaceCategory}" Target="create" MinWidth="120" Margin="0,4,0,12"/>
  <TextBlock Text="צבע" FontSize="12" Foreground="#667388" Margin="0,0,0,6"/>
  <local:WorkspaceColorPicker PaletteName="Capture palette" SelectedColor="{Binding NewWorkspaceColor}" Palette="{Binding DesignPalette}" Target="create"/>
  <TextBlock Text="תמונת רקע" FontSize="12" Foreground="#667388" Margin="0,12,0,0"/>
  <TextBox Text="{Binding NewWorkspaceImagePath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DetailsInput}" FlowDirection="LeftToRight" TextAlignment="Left" Margin="0,4,0,8" AutomationProperties.Name="Capture card image path" ToolTip="הנתיב המלא של התמונה שנבחרה"/>
  <WrapPanel HorizontalAlignment="Right"><Button Content="העלה תמונה" Command="{Binding PickCreateImageCommand}" Style="{StaticResource DialogSecondaryButton}" Margin="0,0,8,4" AutomationProperties.Name="Upload capture image"/><Button Content="הסר תמונה" Command="{Binding RemoveCreateImageCommand}" Style="{StaticResource DialogSecondaryButton}" Margin="0,0,0,4" AutomationProperties.Name="Remove capture image"/></WrapPanel>
  <TextBlock Text="רק הפריטים המסומנים בצד ימין יתווספו." TextWrapping="Wrap" Foreground="#667388" FontSize="12" Margin="0,12,0,0"/>
  <TextBlock Text="{Binding CreateError}" Foreground="#9B3030" TextWrapping="Wrap"/>
  <Button Content="צור סביבה מהלכידה" Command="{Binding CaptureCreateCommand}" Style="{StaticResource DialogPrimaryButton}" HorizontalAlignment="Right" Margin="0,16,0,0" AutomationProperties.Name="Create workspace from capture"/>
 </StackPanel>
                        </StackPanel></ScrollViewer>

                        <DockPanel Visibility="{Binding IsCapturePick, Converter={StaticResource B2V}}">
                            <TextBlock DockPanel.Dock="Top" Text="סביבה קיימת" FontWeight="SemiBold"/>
                            <TextBox Style="{StaticResource DetailsInput}" DockPanel.Dock="Top" Margin="0,8,0,12" Text="{Binding CaptureSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Capture workspace search"/>
                            <ListBox ItemsSource="{Binding CaptureWorkspaceResults}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.CapturePickWorkspaceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalContentAlignment="Right" Background="Transparent" BorderThickness="0" Padding="6,2" AutomationProperties.Name="{Binding Name, StringFormat='Pick workspace {0}'}">
                                            <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding EffectiveCategory}" Foreground="Gray" FontSize="11"/></StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <ScrollViewer Style="{StaticResource CaptureTargetViewport}" FocusVisualStyle="{StaticResource SolidDialogFocus}" Visibility="{Binding IsCaptureSide, Converter={StaticResource B2V}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" FlowDirection="RightToLeft" Margin="-24,-16,-24,-16" AutomationProperties.Name="Capture target viewport">
                         <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource CapturePaneScrollBar}"/></ScrollViewer.Resources>
                        <DockPanel x:Name="CaptureDropZone" FlowDirection="LeftToRight" Margin="24,16" AllowDrop="True" Background="Transparent" Drop="CaptureDropZone_Drop" DragOver="CaptureDropZone_DragOver">
      <TextBlock DockPanel.Dock="Top" Text="{Binding CaptureWorkspaceItems.Count, StringFormat='כבר שמור בסביבה · {0}'}" HorizontalAlignment="Right" FlowDirection="RightToLeft" FontSize="12" Foreground="#667388" Margin="0,0,0,12"/>
      <ListBox DockPanel.Dock="Top" HorizontalContentAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Disabled" ItemsSource="{Binding CaptureWorkspaceItems}" BorderThickness="0" Background="White" Padding="0" FlowDirection="RightToLeft" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Saved items in the workspace"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#E6EAF1" BorderThickness="0,0,0,1" Padding="0,12"><Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="180"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Target}" Foreground="#667388" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" TextAlignment="Left" FlowDirection="LeftToRight"/><TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="#222833" TextAlignment="Right" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><Border Grid.Column="2" Width="30" Height="30" CornerRadius="5" Background="#F0F4FB" BorderBrush="#D5DFF1" BorderThickness="1" HorizontalAlignment="Right"><local:TargetIcon Target="{Binding Target}" ItemType="{Binding Type}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
      <TextBlock DockPanel.Dock="Top" Text="{Binding StagedRows.Count, StringFormat='נוסף כעת, עדיין לא נשמר · {0}'}" HorizontalAlignment="Right" FlowDirection="RightToLeft" FontSize="12" Foreground="#667388" Margin="0,12,0,0"/>
      <ListBox ItemsSource="{Binding StagedRows}" HorizontalContentAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Added items not saved yet" BorderThickness="0" Background="White" FlowDirection="RightToLeft" Padding="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,10" Focusable="True" KeyboardNavigation.IsTabStop="True" ToolTip="פעולות האייטם: קליק ימני, Menu או Shift+F10" ContextMenuOpening="RowContextMenu_Opening" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="Staged item row" FlowDirection="LeftToRight">
                                            <StackPanel.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="הצג בתיקייה" Command="{Binding PlacementTarget.Tag.ShowInFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}">
                                                                <MenuItem.Style><Style TargetType="MenuItem" BasedOn="{StaticResource SharedMenuItem}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasContainingFolder}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></MenuItem.Style>
                                                            </MenuItem>
                                                            <MenuItem Header="מחיקה" Command="{Binding PlacementTarget.Tag.RemoveStagedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                            <MenuItem Header="העתק כתובת" Command="{Binding PlacementTarget.Tag.StagedCopyAddressCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                            <MenuItem Header="עריכת כתובת" Command="{Binding PlacementTarget.Tag.StagedEditAddressCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                            <MenuItem Header="פתח באמצעות" Command="{Binding PlacementTarget.Tag.StagedOpenWithCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}">
                                                                <MenuItem.Style><Style TargetType="MenuItem" BasedOn="{StaticResource SharedMenuItem}"><Style.Triggers><DataTrigger Binding="{Binding IsProgram}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></MenuItem.Style>
                                                            </MenuItem>
                                                            <Separator/><MenuItem Header="הזז למעלה" Command="{Binding PlacementTarget.Tag.StagedMoveUpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                            <MenuItem Header="הזז למטה" Command="{Binding PlacementTarget.Tag.StagedMoveDownCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                        </ContextMenu>
                                                    </StackPanel.ContextMenu>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource CompactIconButton}" AutomationProperties.Name="{Binding OriginalName, StringFormat='Remove added {0}'}" Command="{Binding DataContext.RemoveStagedCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="Collapsed"/>
                                                <Button DockPanel.Dock="Left" Click="ToggleStaged_Click" FocusVisualStyle="{StaticResource SolidDialogFocus}" Width="32" Height="32" MinWidth="0" MinHeight="0" Padding="8,2" BorderThickness="0" Margin="0,0,12,0" AutomationProperties.Name="{Binding OriginalName, StringFormat='Toggle added {0}'}" CommandParameter="{Binding}"><Button.Template><ControlTemplate TargetType="Button"><Border Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template><Button.Style><Style TargetType="Button" BasedOn="{StaticResource HomeToolbarButton}"><Setter Property="Command" Value="{Binding DataContext.EditStagedCommand, RelativeSource={RelativeSource AncestorType=Window}}"/><Setter Property="ToolTip" Value="פתח עריכת אייטם"/><Style.Triggers><DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Command" Value="{Binding DataContext.CloseStagedEditCommand, RelativeSource={RelativeSource AncestorType=Window}}"/><Setter Property="ToolTip" Value="סגור עריכת אייטם"/></DataTrigger></Style.Triggers></Style></Button.Style><Grid Width="15" Height="15"><Border Width="9" Height="9" BorderThickness="0,0,2,2" BorderBrush="#55606F" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"><Border.Style><Style TargetType="Border"><Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="45"/></Setter.Value></Setter><Style.Triggers><DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="225"/></Setter.Value></Setter></DataTrigger></Style.Triggers></Style></Border.Style></Border></Grid></Button>
                                                <Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="180"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Target}" Foreground="#667388" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0" AutomationProperties.AutomationId="StagedItemAddress" FlowDirection="LeftToRight" TextAlignment="Left"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding Name}" TextAlignment="Right" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="StagedItemName" FontSize="14"/>
                                                        <TextBlock Text="{Binding TypeLabel}" TextAlignment="Right" Foreground="#667388" FontSize="12"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="5" Background="#F0F4FB" BorderBrush="#D5DFF1" BorderThickness="1"><local:TargetIcon Target="{Binding Target}" ItemType="{Binding Type}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                </Grid>
                                            </DockPanel>
                                            <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource B2V}}" Margin="0,4,0,0" AutomationProperties.Name="Staged item editor"><Border Background="#F4F6FD" BorderBrush="#C8D5F5" BorderThickness="0,1,0,0" Padding="10" Margin="0,4,0,0"><StackPanel FlowDirection="LeftToRight">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
 <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Grid.Column" Value="2"/><Style.Triggers><DataTrigger Binding="{Binding OpenWithApplicable}" Value="False"><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="3"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="שם האייטם" TextAlignment="Right" FontSize="12" Foreground="#667388"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DetailsInput}" TextAlignment="Right" Height="34" MinHeight="34" FontSize="14" Padding="10,6" Margin="0,4,0,10" AutomationProperties.Name="Added item name"/></StackPanel>
 <StackPanel Grid.Column="0" Visibility="{Binding OpenWithApplicable, Converter={StaticResource B2V}}"><TextBlock Text="פתח באמצעות" TextAlignment="Right" FontSize="12" Foreground="#667388"/><ComboBox Style="{StaticResource OpenWithDropdown}" local:OpenWithPicker.FileTarget="{Binding FileTarget}" local:OpenWithPicker.WebsiteTarget="{Binding Target}" local:OpenWithPicker.DefaultLabel="{Binding OpenWithDefaultLabel}" local:OpenWithPicker.Path="{Binding OpenWith, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FlowDirection="RightToLeft" Height="34" Margin="0,4,0,10" Background="White" BorderBrush="#C5CDDB" Padding="8,4" AutomationProperties.Name="Added item open with" IsEnabled="{Binding OpenWithEnabled}"/></StackPanel>
 </Grid>
 <TextBlock Text="תיאור" TextAlignment="Right" FontSize="12" Foreground="#667388"/><TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DetailsInput}" TextAlignment="Right" Height="34" MinHeight="34" FontSize="14" Padding="10,6" MaxLength="500" Margin="0,4,0,10" AutomationProperties.Name="Added item description"/>
 <TextBlock Text="{Binding TargetLabel}" TextAlignment="Right" FontSize="12" Foreground="#667388"/><TextBox Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DetailsInput}" FlowDirection="LeftToRight" Height="34" MinHeight="34" FontSize="14" Padding="10,6" Margin="0,4,0,0" AutomationProperties.Name="Added item address"/><TextBlock Text="{Binding TargetError}" Foreground="#9B3030" TextWrapping="Wrap" AutomationProperties.Name="Added item address error"/>
 </StackPanel></Border>
 <TextBlock FlowDirection="RightToLeft" TextAlignment="Left" Text="אפשר לערוך את הפרטים כאן · השינוי נשמר רק בלחיצה על שמור בסביבה" Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" HorizontalAlignment="Right"/>
 </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                        </ScrollViewer>
    </Grid>
    <Border Grid.Row="2" BorderBrush="#D8E0ED" BorderThickness="0,1,0,0" Background="#F7F9FC" Padding="16,12" Visibility="{Binding IsCaptureSide, Converter={StaticResource B2V}}"><DockPanel><Button DockPanel.Dock="Right" Content="שמור בסביבה" Command="{Binding CaptureSaveCommand}" Style="{StaticResource DialogPrimaryButton}" AutomationProperties.Name="Capture save"/><TextBlock Text="אחרי השמירה אפשר לבחור יעד נוסף" Foreground="#667388" FontSize="12" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/></DockPanel></Border>
   </Grid></Border>
   <Border Grid.Column="2" Background="White" BorderBrush="#CFD7E6" BorderThickness="1" CornerRadius="4"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#EDF1F7" BorderBrush="#CFD7E6" BorderThickness="0,0,0,1" Padding="16,14"><StackPanel><TextBlock Text="מה נמצא במחשב" FontSize="16" FontWeight="SemiBold" Foreground="#222833" HorizontalAlignment="Right"/><TextBlock Text="מקור לבחירה בלבד. הפריטים כאן לא נערכים." FlowDirection="RightToLeft" TextAlignment="Left" FontSize="12" Foreground="#667388" Margin="0,6,0,0"/></StackPanel></Border>
    <DockPanel Grid.Row="1" Margin="24,16">
     <Grid DockPanel.Dock="Top" Margin="0,0,0,12"><TextBlock Text="{Binding CaptureRows.Count, StringFormat='נמצאו {0} פריטים'}" HorizontalAlignment="Right" FlowDirection="RightToLeft" Foreground="#667388" FontSize="12"/><TextBlock Text="{Binding CaptureSelectionText}" Foreground="#667388" FontSize="12"/></Grid>
     <TextBlock DockPanel.Dock="Top" Text="סורק מה פתוח עכשיו..." Foreground="#667388" FontSize="12" Visibility="{Binding IsScanning, Converter={StaticResource B2V}}"/>
     <TextBlock DockPanel.Dock="Top" Text="לא נמצאו פריטים פתוחים" Foreground="#667388" FontSize="13" HorizontalAlignment="Right" Visibility="{Binding CaptureEmpty, Converter={StaticResource B2V}}"/>
     <Border DockPanel.Dock="Bottom" BorderBrush="#E6EAF1" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0"><TextBlock Text="לא נמצא קובץ? קבצים פתוחים בתוך תוכנות לא נלכדים בבטא. אפשר להוסיף קובץ ידנית לסביבה." FlowDirection="RightToLeft" TextAlignment="Left" Foreground="#667388" FontSize="12" TextWrapping="Wrap" ToolTip="הלכידה קוראת חלונות ולשוניות נגישים בלבד ואינה רשימה מלאה של כל מה שפתוח. בדיקת לשוניות עשויה להחליף ביניהן לרגע. מסמכים פתוחים בתוך תוכנות אינם מזוהים באופן כללי. דפדפנים וגרסאות שונים, חלונות מוגנים ולשוניות לא פעילות עשויים לא להיקרא. אותו אתר בכמה דפדפנים מופיע בנפרד לכל דפדפן. הדפדפן נשמר כשזוהה; הפרופיל אינו נשמר. אפשר להוסיף פריטים ידנית." ToolTipService.ShowDuration="30000"/></Border>
     <ListBox x:Name="CaptureList" ItemsSource="{Binding CaptureRows}" BorderThickness="0" Background="White" Padding="0" FlowDirection="RightToLeft" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseLeftButtonDown="CaptureList_PreviewMouseLeftButtonDown" PreviewMouseMove="CaptureList_PreviewMouseMove" AutomationProperties.Name="Open now list"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#E6EAF1" BorderThickness="0,0,0,1" Padding="0,12"><CheckBox Style="{StaticResource CaptureItemChoice}" IsChecked="{Binding IsChecked}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" AutomationProperties.Name="{Binding Label}"><Grid FlowDirection="LeftToRight" Margin="0,0,12,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="180"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Target}" FontSize="12" Foreground="#667388" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" TextAlignment="Left" FlowDirection="LeftToRight"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="#222833" TextAlignment="Right" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding DetailsLabel}" FontSize="12" Foreground="#667388" TextAlignment="Right" Margin="0,2,0,0"/></StackPanel><Border Grid.Column="2" Width="30" Height="30" CornerRadius="5" Background="#F0F4FB" BorderBrush="#D5DFF1" BorderThickness="1" HorizontalAlignment="Right"><local:TargetIcon Target="{Binding Target}" ItemType="{Binding Type}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></CheckBox></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
    </DockPanel>
    <Border Grid.Row="2" BorderBrush="#D8E0ED" BorderThickness="0,1,0,0" Background="#F7F9FC" Padding="16,12"><Button FlowDirection="RightToLeft" Content="{Binding CaptureAddLabel}" Command="{Binding CaptureAddCommand}" Style="{StaticResource DialogPrimaryButton}" HorizontalAlignment="Right" Visibility="{Binding IsCaptureSide, Converter={StaticResource B2V}}" AutomationProperties.Name="Add selected capture items"/></Border>
   </Grid></Border>
  </Grid>
 </Grid>
</Grid>


</UserControl>
