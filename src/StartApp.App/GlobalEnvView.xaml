<UserControl x:Class="StartApp.App.GlobalEnvView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:StartApp.Core;assembly=StartApp.Core"
             FlowDirection="RightToLeft" Background="#f7f8fb"
             FontFamily="Noto Sans Hebrew, Segoe UI"
             AutomationProperties.Name="Global environment screen">
    <!-- Approved סביבה גלובלית handoff (22.11 03:08, visual global-env-f1): one page with three groups.
         DataContext is the hosting window's MainViewModel. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="White" BorderBrush="#c5cad4" BorderThickness="1" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#315cc5" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GroupBox" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#e3e7ee"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="AddLink" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#315cc5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#667388"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header: breadcrumbs, title, back -->
        <Grid Grid.Row="0" Margin="24,14,24,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="סביבות העבודה / סביבה גלובלית" FontSize="12" Foreground="#636e7d" HorizontalAlignment="Right"/>
            <DockPanel Grid.Row="1" Margin="0,10,0,0">
                <Button DockPanel.Dock="Left" Content="חזרה לסביבות" Style="{StaticResource SecondaryButton}" MinHeight="38"
                        Command="{Binding CloseGlobalEnvCommand}"
                        AutomationProperties.Name="Back to workspaces"/>
                <StackPanel>
                    <TextBlock Text="סביבה גלובלית" FontSize="22" FontWeight="SemiBold" Foreground="#222833" HorizontalAlignment="Right"
                               AutomationProperties.Name="Global environment title"/>
                    <TextBlock Text="מרכז אחד לכל מה שקורה תמיד: פריטים שנפתחים עם הפעלת המחשב, ושינויים ללכידה." FontSize="13" Foreground="#626b79" HorizontalAlignment="Right"/>
                </StackPanel>
            </DockPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="24,10,24,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- group 1: global environment items -->
                <Border Style="{StaticResource GroupBox}">
                    <StackPanel>
                        <Border Background="#f4f6fa" CornerRadius="6,6,0,0" Padding="12,8">
                            <DockPanel>
                                <Button DockPanel.Dock="Left" Content="＋ הוסף אייטם" Style="{StaticResource AddLink}"
                                        Command="{Binding StartGlobalAddCommand}" CommandParameter="{x:Static core:GlobalListKind.GlobalItems}"
                                        AutomationProperties.Name="Add global item"/>
                                <TextBlock Text="פריטי הסביבה הגלובלית" FontSize="14" FontWeight="SemiBold" Foreground="#222833" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </Border>
                        <TextBlock Style="{StaticResource HintText}" Margin="14,8,14,4" Text="נפתחים אוטומטית עם הפעלת המחשב, תמיד."/>
                        <ItemsControl ItemsSource="{Binding GlobalItemRows}" AutomationProperties.Name="Global items list">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Border BorderBrush="#eef1f6" BorderThickness="0,0,0,1" Padding="12,6">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Left" Content="הסרה" Style="{StaticResource SecondaryButton}" Padding="10,3"
                                                Command="{Binding DataContext.RemoveGlobalEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                AutomationProperties.Name="Remove global entry"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Target}" FlowDirection="LeftToRight" Foreground="#667388" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                        <StackPanel DockPanel.Dock="Right">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#222833" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding DescriptionLine}" FontSize="11" Foreground="#667388" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- group 2: capture whitelist -->
                <Border Style="{StaticResource GroupBox}">
                    <StackPanel>
                        <Border Background="#f4f6fa" CornerRadius="6,6,0,0" Padding="12,8">
                            <DockPanel>
                                <Button DockPanel.Dock="Left" Content="＋ הוסף אייטם" Style="{StaticResource AddLink}"
                                        Command="{Binding StartGlobalAddCommand}" CommandParameter="{x:Static core:GlobalListKind.Whitelist}"
                                        AutomationProperties.Name="Add whitelist item"/>
                                <TextBlock Text="רשימה לבנה ללכידה" FontSize="14" FontWeight="SemiBold" Foreground="#222833" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </Border>
                        <TextBlock Style="{StaticResource HintText}" Margin="14,8,14,4" Text="יוצגו תמיד בראש תוצאות הלכידה, גם אם לא זוהו פתוחים כרגע."/>
                        <ItemsControl ItemsSource="{Binding WhitelistRows}" AutomationProperties.Name="Whitelist list">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Border BorderBrush="#eef1f6" BorderThickness="0,0,0,1" Padding="12,6">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Left" Content="הסרה" Style="{StaticResource SecondaryButton}" Padding="10,3"
                                                Command="{Binding DataContext.RemoveGlobalEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                AutomationProperties.Name="Remove whitelist entry"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Target}" FlowDirection="LeftToRight" Foreground="#667388" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                        <StackPanel DockPanel.Dock="Right">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#222833" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding DescriptionLine}" FontSize="11" Foreground="#667388" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- group 3: capture blacklist -->
                <Border Style="{StaticResource GroupBox}">
                    <StackPanel>
                        <Border Background="#f4f6fa" CornerRadius="6,6,0,0" Padding="12,8">
                            <DockPanel>
                                <Button DockPanel.Dock="Left" Content="＋ הוסף אייטם" Style="{StaticResource AddLink}"
                                        Command="{Binding StartGlobalAddCommand}" CommandParameter="{x:Static core:GlobalListKind.Blacklist}"
                                        AutomationProperties.Name="Add blacklist item"/>
                                <TextBlock Text="רשימה שחורה ללכידה" FontSize="14" FontWeight="SemiBold" Foreground="#222833" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </Border>
                        <TextBlock Style="{StaticResource HintText}" Margin="14,8,14,4" Text="לא יוצגו באף לכידה, כולל 'הוסף ממה שפתוח', משותף לכל הסביבות."/>
                        <ItemsControl ItemsSource="{Binding BlacklistRows}" AutomationProperties.Name="Blacklist list">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Border BorderBrush="#eef1f6" BorderThickness="0,0,0,1" Padding="12,6">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Left" Content="הסרה" Style="{StaticResource SecondaryButton}" Padding="10,3"
                                                Command="{Binding DataContext.RemoveGlobalEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                AutomationProperties.Name="Remove blacklist entry"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Target}" FlowDirection="LeftToRight" Foreground="#667388" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                        <StackPanel DockPanel.Dock="Right">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#222833" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding DescriptionLine}" FontSize="11" Foreground="#667388" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- inline add form (modal over the page) -->
        <Grid Grid.RowSpan="3" Background="#66000000" Visibility="{Binding AddFormVisible, Converter={StaticResource B2V}}">
            <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="6" Padding="18" MaxWidth="440"
                    VerticalAlignment="Center" HorizontalAlignment="Center" AutomationProperties.Name="Global entry add form">
                <StackPanel>
                    <TextBlock Text="{Binding AddFormListTitle}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,0,10"/>
                    <ComboBox ItemsSource="{Binding GlobalEntryTypeLabels}" SelectedIndex="{Binding NewEntryTypeIndex}" HorizontalAlignment="Right" MinWidth="140" Margin="0,0,0,8"
                              AutomationProperties.Name="Global entry type"/>
                    <TextBox Text="{Binding NewEntryName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" AutomationProperties.Name="Global entry name"/>
                    <TextBox Text="{Binding NewEntryTarget, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" Margin="0,0,0,8" AutomationProperties.Name="Global entry target"/>
                    <TextBlock Style="{StaticResource HintText}" Foreground="#b3261e" Text="{Binding GlobalEnvError}" Visibility="{Binding GlobalEnvErrorVisible, Converter={StaticResource B2V}}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="ביטול" Style="{StaticResource SecondaryButton}" Command="{Binding CancelGlobalAddCommand}" Margin="8,0,0,0" AutomationProperties.Name="Cancel global add"/>
                        <Button Content="הוספה" Style="{StaticResource PrimaryButton}" Command="{Binding ConfirmGlobalAddCommand}" AutomationProperties.Name="Confirm global add"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- bottom note -->
        <TextBlock Grid.Row="2" Style="{StaticResource HintText}" Margin="24,4,24,10"
                   Text="הסרה של רשומת ברירת מחדל מהרשימה השחורה תחזיר אותה ללכידות."/>
    </Grid>
</UserControl>
