<UserControl x:Class="StartApp.App.GlobalEnvView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:core="clr-namespace:StartApp.Core;assembly=StartApp.Core"
             xmlns:local="clr-namespace:StartApp.App"
             FlowDirection="LeftToRight" Background="#F7F8FB"
             FontFamily="./Assets/Fonts/#Noto Sans Hebrew, Arial"
             AutomationProperties.Name="Global environment screen">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource HomeToolbarButton}">
            <Setter Property="MinHeight" Value="38"/><Setter Property="MinWidth" Value="70"/><Setter Property="Padding" Value="14,6"/>
        </Style>
        <Style x:Key="GroupBox" TargetType="Border">
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DCE1E9"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/><Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="GroupHeading" TargetType="Border"><Setter Property="Background" Value="#F0F3F8"/><Setter Property="BorderBrush" Value="#DCE1E9"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="CornerRadius" Value="3,3,0,0"/><Setter Property="Padding" Value="14,6"/></Style>
        <Style x:Key="GroupTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#414856"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FlowDirection" Value="RightToLeft"/></Style>
        <Style x:Key="AddLink" TargetType="Button" BasedOn="{StaticResource QuietTextButton}"><Setter Property="Foreground" Value="#315CC5"/><Setter Property="FontSize" Value="11"/><Setter Property="Padding" Value="0"/></Style>
        <Style x:Key="HintText" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#667388"/><Setter Property="FlowDirection" Value="RightToLeft"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
        <DataTemplate x:Key="GlobalRowTemplate">
            <Border BorderBrush="#EEF1F6" BorderThickness="0,0,0,1" Padding="14,5" MinHeight="49">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
                    <Button Content="הסרה" Style="{StaticResource SecondaryButton}" Command="{Binding DataContext.RemoveGlobalEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" AutomationProperties.Name="Remove global entry"/>
                    <TextBlock Grid.Column="1" Text="{Binding Target}" ToolTip="{Binding Target}" TextTrimming="CharacterEllipsis" FlowDirection="LeftToRight" Foreground="#667388" FontFamily="Arial" FontSize="12" VerticalAlignment="Center" Margin="12,0"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" FlowDirection="RightToLeft" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Width="30" Height="30" CornerRadius="6" Background="#EEF2F9" BorderBrush="#D9E0EF" BorderThickness="1" VerticalAlignment="Center">
                            <local:TargetIcon Target="{Binding Target}" ItemType="{Binding Entry.Type}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="#222833" TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                            <TextBlock Text="{Binding DescriptionLine}" FontSize="11" Foreground="#667388" TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="32,22,32,0">
            <Button Content="חזרה לסביבות" Style="{StaticResource SecondaryButton}" MinWidth="123" HorizontalAlignment="Left" VerticalAlignment="Top" Command="{Binding CloseGlobalEnvCommand}" AutomationProperties.Name="Back to workspaces"/>
            <StackPanel HorizontalAlignment="Right" FlowDirection="RightToLeft">
                <TextBlock Text="סביבה גלובלית" FontSize="22" FontWeight="SemiBold" Foreground="#222833" AutomationProperties.Name="Global environment title"/>
                <TextBlock Text="מרכז אחד לכל מה שקורה תמיד: פריטים שנפתחים עם הפעלת המחשב, ורשימות הלכידה." FontSize="13" Foreground="#626B79"/>
            </StackPanel>
        </Grid>
        <ScrollViewer Grid.Row="1" Margin="32,8,32,0" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" FlowDirection="RightToLeft">
            <ScrollViewer.Resources><sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarWidthKey}">15</sys:Double></ScrollViewer.Resources>
            <StackPanel Margin="0,16,0,0" FlowDirection="LeftToRight">
                <Border Style="{StaticResource GroupBox}"><StackPanel>
                    <Border Style="{StaticResource GroupHeading}"><DockPanel>
                        <Button DockPanel.Dock="Left" Content="＋ הוסף אייטם" Style="{StaticResource AddLink}" Command="{Binding StartGlobalAddCommand}" CommandParameter="{x:Static core:GlobalListKind.GlobalItems}" AutomationProperties.Name="Add global item"/>
                        <TextBlock Text="פריטי הסביבה הגלובלית" Style="{StaticResource GroupTitle}"/>
                    </DockPanel></Border>
                    <TextBlock Style="{StaticResource HintText}" Margin="14,10,14,4" Text="נפתחים אוטומטית עם הפעלת המחשב, תמיד."/>
                    <ItemsControl ItemsSource="{Binding GlobalItemRows}" ItemTemplate="{StaticResource GlobalRowTemplate}" AutomationProperties.Name="Global items list"/>
                </StackPanel></Border>
                <Border Style="{StaticResource GroupBox}"><StackPanel>
                    <Border Style="{StaticResource GroupHeading}"><DockPanel>
                        <Button DockPanel.Dock="Left" Content="＋ הוסף אייטם" Style="{StaticResource AddLink}" Command="{Binding StartGlobalAddCommand}" CommandParameter="{x:Static core:GlobalListKind.Whitelist}" AutomationProperties.Name="Add whitelist item"/>
                        <TextBlock Text="רשימה לבנה ללכידה" Style="{StaticResource GroupTitle}"/>
                    </DockPanel></Border>
                    <TextBlock Style="{StaticResource HintText}" Margin="14,10,14,4" Text="יוצגו תמיד בראש תוצאות הלכידה, גם אם לא זוהו פתוחים כרגע."/>
                    <ItemsControl ItemsSource="{Binding WhitelistRows}" ItemTemplate="{StaticResource GlobalRowTemplate}" AutomationProperties.Name="Whitelist list"/>
                </StackPanel></Border>
                <Border Style="{StaticResource GroupBox}"><StackPanel>
                    <Border Style="{StaticResource GroupHeading}"><DockPanel>
                        <Button DockPanel.Dock="Left" Content="＋ הוסף אייטם" Style="{StaticResource AddLink}" Command="{Binding StartGlobalAddCommand}" CommandParameter="{x:Static core:GlobalListKind.Blacklist}" AutomationProperties.Name="Add blacklist item"/>
                        <TextBlock Text="רשימה שחורה ללכידה" Style="{StaticResource GroupTitle}"/>
                    </DockPanel></Border>
                    <TextBlock Style="{StaticResource HintText}" Margin="14,10,14,4" Text="לא יוצגו באף לכידה, כולל 'הוסף ממה שפתוח', משותף לכל הסביבות."/>
                    <ItemsControl ItemsSource="{Binding BlacklistRows}" ItemTemplate="{StaticResource GlobalRowTemplate}" AutomationProperties.Name="Blacklist list"/>
                </StackPanel></Border>
            </StackPanel>
        </ScrollViewer>
        <TextBlock Grid.Row="2" Style="{StaticResource HintText}" Margin="32,10,32,18" Text="הסרה של רשומת ברירת מחדל מהרשימה השחורה תחזיר אותה ללכידות."/>
        <Grid Grid.RowSpan="3" Background="#66000000" Visibility="{Binding AddFormVisible, Converter={StaticResource B2V}}">
            <Border Background="White" BorderBrush="#DCE1E9" BorderThickness="1" CornerRadius="6" Padding="24" Width="440" VerticalAlignment="Center" HorizontalAlignment="Center" AutomationProperties.Name="Global entry add form">
                <StackPanel FlowDirection="RightToLeft">
                    <TextBlock Text="{Binding AddFormListTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <TextBlock Text="סוג" Style="{StaticResource DetailsLabel}"/>
                    <ComboBox ItemsSource="{Binding GlobalEntryTypeLabels}" SelectedIndex="{Binding NewEntryTypeIndex}" Style="{StaticResource DetailsCombo}" Margin="0,0,0,12" AutomationProperties.Name="Global entry type"/>
                    <TextBlock Text="שם" Style="{StaticResource DetailsLabel}"/>
                    <TextBox Text="{Binding NewEntryName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DetailsInput}" Margin="0,0,0,12" AutomationProperties.Name="Global entry name"/>
                    <TextBlock Text="כתובת" Style="{StaticResource DetailsLabel}"/>
                    <TextBox Text="{Binding NewEntryTarget, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DetailsInput}" FlowDirection="LeftToRight" Margin="0,0,0,12" AutomationProperties.Name="Global entry target"/>
                    <TextBlock Style="{StaticResource HintText}" Foreground="#B3261E" Text="{Binding GlobalEnvError}" Visibility="{Binding GlobalEnvErrorVisible, Converter={StaticResource B2V}}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="הוספה" Style="{StaticResource PrimaryActionButton}" Command="{Binding ConfirmGlobalAddCommand}" AutomationProperties.Name="Confirm global add"/>
                        <Button Content="ביטול" Style="{StaticResource SecondaryButton}" Command="{Binding CancelGlobalAddCommand}" Margin="8,0,0,0" AutomationProperties.Name="Cancel global add"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
