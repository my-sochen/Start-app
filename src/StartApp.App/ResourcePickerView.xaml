<local:DialogFrame x:Class="StartApp.App.ResourcePickerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:StartApp.App" xmlns:sys="clr-namespace:System;assembly=System.Runtime" MinWidth="460">
    <local:DialogFrame.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <local:ItemTypeNameConverter x:Key="ItemTypeName"/>
    </local:DialogFrame.Resources>
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="✕" Command="{Binding ClosePickerCommand}" Style="{StaticResource CompactIconButton}" AutomationProperties.Name="Close resource picker" ToolTip="סגור"/>
                        <TextBlock Text="בחר מסביבות קיימות" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding PickerTypes}" HorizontalAlignment="Right">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Button Padding="10,2" Margin="0,0,4,0" Command="{Binding DataContext.PickTypeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                    Content="{Binding Converter={StaticResource ItemTypeName}}" AutomationProperties.Name="Picker type"/>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox Text="{Binding PickerSearch, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" AutomationProperties.Name="Search resources" ToolTip="חיפוש"/>
                    <ListBox HorizontalContentAlignment="Stretch" ItemsSource="{Binding PickerRows}" MaxHeight="200" Margin="0,6,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Resource list">
                        <ListBox.ItemTemplate><DataTemplate>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="בחר" Padding="8,0" Margin="4,0,0,0" AutomationProperties.Name="Pick resource"
                                        Command="{Binding DataContext.PickResourceCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><local:TargetIcon Target="{Binding Target}" ItemType="{Binding Type}" Margin="0,0,5,0"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center"/></StackPanel>
                                    <!-- sites also show the address under the name (settled); other types show the name only -->
                                    <TextBlock Text="{Binding Target}" Foreground="Gray" FontSize="11" TextTrimming="CharacterEllipsis" TextAlignment="Left" FlowDirection="LeftToRight">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
                                            <DataTrigger Binding="{Binding Type}" Value="Link"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                        </Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </local:DialogFrame>
