<Window x:Class="StartApp.App.BrowserHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="עזרה והגדרות דפדפן" Width="620" Height="560" MinWidth="460" MinHeight="400"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" ShowInTaskbar="False">
    <DockPanel Margin="18">
        <Button DockPanel.Dock="Bottom" Content="סגור" Click="Close_Click" IsCancel="True" AutomationProperties.Name="Close browser help" HorizontalAlignment="Left" Padding="18,5" Margin="0,12,0,0"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="לכידת לשוניות: אינה זמינה כעת" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.Name="Browser capture unavailable"/>
                <TextBlock Text="בגרסה מועמדת זו לכידת לשוניות הושבתה כדי למנוע מעבר פיזי בלשוניות. הוספת כתובות ידנית ולכידת תוכנות ותיקיות נשארות זמינות. קישורים שכבר נשמרו אינם משתנים." TextWrapping="Wrap" Margin="0,10,0,0"/>
                <TextBlock Text="מה אפשר לעשות עכשיו" FontWeight="SemiBold" Margin="0,16,0,6"/>
                <TextBlock Text="העתיקו כתובת אתר והוסיפו אותה בשדה כתובת האייטם בסביבה. אין צורך להפעיל הרשאת דפדפן בשביל הוספה ידנית." TextWrapping="Wrap"/>
                <TextBlock Text="עיון ידני בהגדרות Chrome ו-Edge" FontWeight="SemiBold" Margin="0,16,0,6"/>
                <TextBlock Text="אין צורך להפעיל הרשאת דפדפן בגרסה זו" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6" AutomationProperties.Name="No browser permission needed"/>
                <TextBlock Text="לכידת לשוניות אינה זמינה. הפעלת remote debugging לא תאפשר אותה בגרסה זו. ההרשאה יכולה לאפשר לאפליקציה שאושרה שליטה רחבה בדפדפן, כולל נתונים שמורים וניווט. הכתובות שלהלן מיועדות לעיון ידני בלבד, לא כשלב נדרש להפעלת האפליקציה." TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Text="הכפתורים מעתיקים כתובת פנימית בלבד. כדי לעיין בהגדרות, הדביקו אותה בשורת הכתובת של הדפדפן המתאים. האפליקציה אינה פותחת את העמוד או משנה את ההגדרה." TextWrapping="Wrap"/>
                <Button Content="העתק כתובת הגדרות Chrome" Click="CopyChrome_Click" AutomationProperties.Name="Copy Chrome settings address" Padding="8,5" Margin="0,8,0,4"/>
                <TextBox x:Name="ChromeAddress" IsReadOnly="True" FlowDirection="LeftToRight" AutomationProperties.Name="Chrome settings address"/>
                <Button Content="העתק כתובת הגדרות Edge" Click="CopyEdge_Click" AutomationProperties.Name="Copy Edge settings address" Padding="8,5" Margin="0,8,0,4"/>
                <TextBox x:Name="EdgeAddress" IsReadOnly="True" FlowDirection="LeftToRight" AutomationProperties.Name="Edge settings address"/>
                <TextBlock x:Name="CopyStatus" AutomationProperties.Name="Browser help copy status" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <TextBlock Text="ניתוק אינו כיבוי הרשאה" FontWeight="SemiBold" Margin="0,16,0,6"/>
                <TextBlock Text="סגירת חיבור של האפליקציה אינה מכבה את הגדרת הדפדפן. כיבוי ההגדרה נעשה ידנית בדפדפן. אין כאן כפתור ביטול הרשאה אוטומטי." TextWrapping="Wrap"/>
                <TextBlock Text="התנהגות מתוכננת, עדיין לא זמינה" FontWeight="SemiBold" Margin="0,16,0,6"/>
                <TextBlock Text="לכידה עתידית אמורה לבקש אישור חדש בכל בקשת לכידה ולהתנתק אחריה. חיבור לסשן קיים ותאימות לשני הדפדפנים עדיין לא אומתו במוצר; אין כרגע בקשת חיבור או אישור מהאפליקציה." TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
