<Window x:Class="StartApp.App.DefaultEnvPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StartApp.App"
        Title="בחירת סביבת ברירת מחדל" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft"
        ShowInTaskbar="False" Background="Transparent" AllowsTransparency="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
    </Window.Resources>
    <!-- options-default-env-f1 (approved 22.11 03:03): borderless white card, breadcrumb + ✕, h1, subtitle,
         one radio row per workspace (color dot + name + category), "ללא סביבת ברירת מחדל" last, אישור + ביטול. -->
    <Border Background="White" CornerRadius="10" Padding="26,18,26,20" BorderBrush="#C9D0DC" BorderThickness="1">
        <Border.Effect><DropShadowEffect BlurRadius="34" ShadowDepth="12" Direction="270" Opacity="0.18" Color="#1A2436"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <Button DockPanel.Dock="Left" Content="✕" Click="Cancel_Click" Background="Transparent" BorderThickness="0"
                        Foreground="#626B79" FontSize="13" Padding="4,1" Cursor="Hand" AutomationProperties.Name="Close default workspace picker"/>
                <TextBlock Text="אופציות · הגדר סביבה כברירת מחדל" FontSize="12" Foreground="#636E7D" HorizontalAlignment="Right"/>
            </DockPanel>

            <TextBlock Grid.Row="1" Text="בחירת סביבת ברירת מחדל" FontSize="22" FontWeight="SemiBold" Foreground="#222833" TextAlignment="Right"/>
            <TextBlock Grid.Row="2" Margin="0,8,0,14" TextWrapping="Wrap" TextAlignment="Right" FontSize="13" Foreground="#626B79"
                       Text="הסביבה שנבחרה תסומן בתג הירוק במסך הבית ותיפתח אוטומטית עם הפעלת המחשב."/>

            <ListBox Grid.Row="3" x:Name="Rows" BorderThickness="0" Background="Transparent"
                     SelectionMode="Single" ScrollViewer.VerticalScrollBarVisibility="Auto" MaxHeight="330">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Row" Background="Transparent" BorderBrush="#E6EAF1" BorderThickness="0,0,0,1">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="#EEF2FA"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="2,13">
                            <!-- radio circle on the left edge: empty ring; when the row is selected it fills blue with a ✓ -->
                            <Border DockPanel.Dock="Left" Width="18" Height="18" CornerRadius="9" VerticalAlignment="Top" Margin="0,1,0,0"
                                    BorderBrush="#C5CAD4" BorderThickness="1.5" Background="White">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="Background" Value="#315CC5"/>
                                                <Setter Property="BorderBrush" Value="#315CC5"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="✓" Foreground="White" FontSize="11" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <StackPanel>
                                <DockPanel HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="#222833" VerticalAlignment="Center"/>
                                    <Ellipse Width="11" Height="11" Margin="0,0,7,0" VerticalAlignment="Center"
                                             Fill="{Binding ColorHex, Converter={StaticResource TopBarBrush}}"
                                             Visibility="{Binding HasColor, Converter={StaticResource B2V}}"/>
                                </DockPanel>
                                <TextBlock Text="{Binding Category}" FontSize="12" Foreground="#667388" TextAlignment="Right" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="4" Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Left" Margin="0,18,0,0">
                <Button Content="ביטול" Click="Cancel_Click" Background="White" BorderBrush="#C5CAD4" BorderThickness="1"
                        Foreground="#414856" Padding="16,7" Margin="0,0,8,0" Cursor="Hand" AutomationProperties.Name="Cancel default workspace choice"/>
                <Button Content="אישור" Click="Confirm_Click" Style="{StaticResource PrimaryActionButton}" Padding="16,7"
                        AutomationProperties.Name="Confirm default workspace choice"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
