<Window x:Class="StartApp.App.DefaultEnvPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StartApp.App"
        Title="בחירת סביבת ברירת מחדל" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" WindowStartupLocation="CenterOwner" FlowDirection="LeftToRight"
        FontFamily="./Assets/Fonts/#Noto Sans Hebrew, Arial" ShowInTaskbar="False" Background="Transparent" AllowsTransparency="True" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
    </Window.Resources>
    <!-- Immediate row selection; the close button leaves the default unchanged. -->
    <Border Background="White" CornerRadius="10" Padding="26,28,26,40" BorderBrush="#C9D0DC" BorderThickness="1">
        <Border.Effect><DropShadowEffect BlurRadius="34" ShadowDepth="12" Direction="270" Opacity="0.18" Color="#1A2436"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,16">
                <Button DockPanel.Dock="Left" Content="✕" Click="Cancel_Click" Background="Transparent" BorderThickness="0"
                        Foreground="#626B79" FontSize="13" Padding="4,1" Cursor="Hand" AutomationProperties.Name="Close default workspace picker"/>
                <TextBlock Text="אופציות · הגדר סביבה כברירת מחדל" FontSize="12" Foreground="#636E7D" HorizontalAlignment="Right"/>
            </DockPanel>

            <TextBlock Grid.Row="1" Text="בחירת סביבת ברירת מחדל" FontSize="22" FontWeight="SemiBold" Foreground="#222833" TextAlignment="Right"/>
            <TextBlock Grid.Row="2" Margin="0,8,0,14" TextWrapping="Wrap" FlowDirection="RightToLeft" TextAlignment="Left" FontSize="13" Foreground="#626B79" LineHeight="24">
                <Run Text="הסביבה שנבחרה תסומן בנקודה הירוקה במסך הבית ותיפתח אוטומטית עם הפעלת המחשב."/><LineBreak/>
                <Run Text="לחיצה על שורה בוחרת וסוגרת את החלון."/>
            </TextBlock>

            <ListBox Grid.Row="3" x:Name="Rows" BorderThickness="0" Background="Transparent"
                     SelectionMode="Single" PreviewMouseLeftButtonUp="Rows_MouseLeftButtonUp" ScrollViewer.VerticalScrollBarVisibility="Auto" MaxHeight="458">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Row" Background="Transparent" BorderBrush="#E6EAF1" BorderThickness="0,0,0,1">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsLast}" Value="True"><Setter TargetName="Row" Property="BorderThickness" Value="0"/></DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="#F6F9FF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel VerticalAlignment="Center"><DockPanel.Style><Style TargetType="DockPanel"><Setter Property="Margin" Value="2,13"/><Style.Triggers><DataTrigger Binding="{Binding WorkspaceId}" Value="{x:Null}"><Setter Property="Height" Value="46"/><Setter Property="Margin" Value="2,0"/></DataTrigger></Style.Triggers></Style></DockPanel.Style>
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                <DockPanel HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="#222833" VerticalAlignment="Center"/>
                                    <Ellipse Width="11" Height="11" Margin="8,0,0,0" VerticalAlignment="Center"
                                             Fill="{Binding ColorHex, Converter={StaticResource TopBarBrush}}"
                                             Visibility="{Binding HasColor, Converter={StaticResource B2V}}"/>
                                </DockPanel>
                                <TextBlock Text="{Binding Category}" FontSize="12" Foreground="#667388" TextAlignment="Right" Margin="0,2,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Category}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</Window>
